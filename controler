const db = require("../config/database");

const getQuery = (req, res) => {
  db.query("SELECT * FROM query", (err, result) => {
    if (err) {
      console.error("GET Error:", err);
      return res.status(500).json({ 
        message: "Failed to fetch queries",
        error: err.message 
      });
    }
    res.json(result);
  });
};

const postQuery = (req, res) => {
  console.log("Received POST body:", req.body); // Log incoming data
  
  const { name, email, query } = req.body;
  
  // Validate required fields
  if (!name || !email || !query) {
    return res.status(400).json({
      message: "Missing required fields",
      required: { name, email, query }
    });
  }

  const sql = "INSERT INTO query (Name, Email, Query) VALUES (?, ?, ?)";

  db.query(sql, [name, email, query], (err, result) => {
    if (err) {
      console.error("POST Error:", err); // Log detailed error
      return res.status(500).json({
        message: "Failed to add query",
        error: err.message,
      });
    }
    
    console.log("Query added with ID:", result.insertId);
    
    res.status(201).json({
      message: "Added successfully",
      QueryID: result.insertId,
      data: {
        name,
        email,
        query,
      },
    });
  });
};

const putQuery = (req, res) => {
  const { QueryID } = req.params;
  const { solution } = req.body;

  const sql = "UPDATE query SET Solution = ? WHERE QueryID = ?";

  db.query(sql, [solution, QueryID], (err, result) => {
    if (err) {
      console.error("PUT Error:", err);
      return res.status(500).json({
        message: "Failed to update solution",
        error: err.message,
      });
    }

    if (result.affectedRows === 0) {
      return res.status(404).json({
        message: "Question not found",
      });
    }

    res.json({
      message: "Solution updated successfully",
    });
  });
};

module.exports = { getQuery, postQuery, putQuery };
