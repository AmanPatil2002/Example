import Paper from '@mui/material/Paper';
import { useState, useEffect } from "react";
import axios from "axios";
import {
    Box,
    Typography,
    Table,
    TableBody,
    TableCell,
    TableContainer,
    TableHead,
    TableRow,
    Grid,
    Button,
    TextField,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    Chip,
    IconButton,
    Alert,
    Snackbar,
} from "@mui/material";
import EditIcon from '@mui/icons-material/Edit';
import VisibilityIcon from '@mui/icons-material/Visibility';

const API_URL = import.meta.env.VITE_API_URL;

export default function QueryTable() {
    const [queries, setQueries] = useState([]);
    const [openDialog, setOpenDialog] = useState(false);
    const [selectedQuery, setSelectedQuery] = useState(null);
    const [solution, setSolution] = useState("");
    const [loading, setLoading] = useState(false);
    const [snackbar, setSnackbar] = useState({
        open: false,
        message: "",
        severity: "success"
    });

    useEffect(() => {
        fetchQueries();
    }, []);

    const fetchQueries = async () => {
        try {
            const res = await axios.get(`${API_URL}/api/query`);
            console.log("API Response:", res.data);
            setQueries(res.data);
        } catch (err) {
            console.log("Error details:", err.response?.data || err.message);
            setSnackbar({
                open: true,
                message: "Failed to fetch queries",
                severity: "error"
            });
        }
    };

    const handleOpenDialog = (query) => {
        setSelectedQuery(query);
        setSolution(query.Solution || "");
    };

    const handleCloseDialog = () => {
        setOpenDialog(false);
        setSelectedQuery(null);
        setSolution("");
    };

    const handleSubmitSolution = async () => {
        if (!solution.trim()) {
            setSnackbar({
                open: true,
                message: "Please enter a solution",
                severity: "warning"
            });
            return;
        }

        setLoading(true);
        try {
            const res = await axios.put(`${API_URL}/api/query/${selectedQuery.QueryID}`, {
                solution: solution
            });

            setSnackbar({
                open: true,
                message: "Solution added successfully!",
                severity: "success"
            });
            
            handleCloseDialog();
            fetchQueries(); // Refresh the table
        } catch (err) {
            console.log("Error:", err.response?.data || err.message);
            setSnackbar({
                open: true,
                message: "Failed to add solution",
                severity: "error"
            });
        } finally {
            setLoading(false);
        }
    };

    const handleCloseSnackbar = () => {
        setSnackbar({ ...snackbar, open: false });
    };

    return (
        <Box className="p-6">
            <Typography
                variant="h4"
                align="center"
                fontWeight="bold"
                gutterBottom
                className="mb-6 text-gray-800"
            >
                Query Management
            </Typography>


            <Paper elevation={3} className="overflow-hidden rounded-lg">
                <TableContainer className="max-h-[600px]">
                    <Table stickyHeader>
                        <TableHead>
                            <TableRow>
        
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "20%" }}
                                >
                                    User Details
                                </TableCell>
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "35%" }}
                                >
                                    Query
                                </TableCell>
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "30%" }}
                                >
                                    Solution
                                </TableCell>
                                <TableCell
                                    className="font-bold text-lg bg-gray-100"
                                    align="center"
                                    sx={{ width: "10%" }}
                                >
                                    Action
                                </TableCell>
                            </TableRow>
                        </TableHead>
                        <TableBody>
                            {queries.map((query) => (
                                <TableRow
                                    key={query.QueryID}
                                    className="hover:bg-gray-50 transition-colors"
                                    sx={{
                                        bgcolor: !query.Solution ? "warning.lightest" : "inherit"
                                    }}
                                >
                                    
                                    <TableCell align="left" className="py-4">
                                        <Grid container spacing={1}>
                                            <Grid item xs={12}>
                                                <Typography variant="body2">
                                                    <b>Name:</b> {query.Name}
                                                </Typography>
                                            </Grid>
                                            <Grid item xs={12}>
                                                <Typography variant="body2" color="text.secondary">
                                                    <b>Email:</b> {query.Email}
                                                </Typography>
                                            </Grid>
                                        </Grid>
                                    </TableCell>
                                    <TableCell align="left" className="py-4">
                                        <Typography variant="body2">
                                            {query.Query}
                                        </Typography>
                                    </TableCell>
                                    <TableCell align="left" className="py-4">
                                        {query.Solution ? (
                                            <Box sx={{ bgcolor: "success.light", p: 1, borderRadius: 1 }}>
                                                <Typography variant="body2" color="success.dark">
                                                    {query.Solution}
                                                </Typography>
                                            </Box>
                                        ) : (
                                            <Chip 
                                                label="Pending" 
                                                color="warning" 
                                                size="small"
                                                variant="outlined"
                                            />
                                        )}
                                    </TableCell>
                                    <TableCell align="center" className="py-4">
                                        <Button
                                            variant="contained"
                                            size="small"
                                            startIcon={query.Solution ? <EditIcon /> : <VisibilityIcon />}
                                            onClick={() => handleOpenDialog(query)}
                                            color={query.Solution ? "primary" : "warning"}
                                        >
                                            {query.Solution ? "Edit" : "Answer"}
                                        </Button>
                                    </TableCell>
                                </TableRow>
                            ))}
                        </TableBody>
                    </Table>
                </TableContainer>
            </Paper>

            {/* Solution Dialog */}
            <Dialog 
                open={Boolean(selectedQuery)} 
                onClose={handleCloseDialog}
                maxWidth="md"
                fullWidth
            >
                {selectedQuery && (
                    <>
                        <DialogTitle>
                            <Typography variant="h6" fontWeight="bold">
                                {selectedQuery.Solution ? "Edit Solution" : "Add Solution"}
                            </Typography>
                        </DialogTitle>
                        <DialogContent>
                            <Box sx={{ mt: 2 }}>
                                {/* Query Details */}
                                <Paper sx={{ p: 2, mb: 3, bgcolor: "grey.50" }}>
                                    <Typography variant="subtitle2" color="text.secondary" gutterBottom>
                                        Query Details:
                                    </Typography>
                                    <Grid container spacing={2}>
                                        <Grid item xs={6}>
                                            <Typography variant="body2">
                                                <b>Name:</b> {selectedQuery.Name}
                                            </Typography>
                                        </Grid>
                                        <Grid item xs={6}>
                                            <Typography variant="body2">
                                                <b>Email:</b> {selectedQuery.Email}
                                            </Typography>
                                        </Grid>
                                        <Grid item xs={12}>
                                            <Typography variant="body2">
                                                <b>Query:</b> {selectedQuery.Query}
                                            </Typography>
                                        </Grid>
                                    </Grid>
                                </Paper>

                                {/* Solution Input */}
                                <TextField
                                    fullWidth
                                    label="Your Solution"
                                    multiline
                                    rows={6}
                                    value={solution}
                                    onChange={(e) => setSolution(e.target.value)}
                                    placeholder="Type your solution here..."
                                    variant="outlined"
                                    required
                                />
                            </Box>
                        </DialogContent>
                        <DialogActions sx={{ p: 2 }}>
                            <Button onClick={handleCloseDialog} color="inherit">
                                Cancel
                            </Button>
                            <Button
                                onClick={handleSubmitSolution}
                                variant="contained"
                                disabled={loading || !solution.trim()}
                                color="primary"
                            >
                                {loading ? "Saving..." : "Save Solution"}
                            </Button>
                        </DialogActions>
                    </>
                )}
            </Dialog>

            {/* Snackbar for notifications */}
            <Snackbar
                open={snackbar.open}
                autoHideDuration={4000}
                onClose={handleCloseSnackbar}
                anchorOrigin={{ vertical: "bottom", horizontal: "right" }}
            >
                <Alert 
                    onClose={handleCloseSnackbar} 
                    severity={snackbar.severity}
                    variant="filled"
                >
                    {snackbar.message}
                </Alert>
            </Snackbar>
        </Box>
    );
}
