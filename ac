import CssBaseline from '@mui/material/CssBaseline';
import {
    Box,
    Container,
    Grid,
    TextField,
    Typography,
    Avatar,
    Divider,
    Paper,
    CircularProgress,
    Alert,
    IconButton,
    Tooltip,
} from "@mui/material";
import EditIcon from '@mui/icons-material/Edit';
import SaveIcon from '@mui/icons-material/Save';
import CancelIcon from '@mui/icons-material/Cancel';
import { useState, useEffect } from 'react';
import axios from "axios";

const API_URL = import.meta.env.VITE_API_URL;

const SectionTitle = ({ title }) => (
    <Typography
        variant="h5"
        sx={{
            mt: 4,
            mb: 2,
            color: "primary.main",
            fontWeight: "bold",
        }}
    >
        {title}
    </Typography>
);

function Account({ darkMode, toggleTheme }) {
    const [accountInfo, setAccountInfo] = useState(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState(null);
    const [isEditing, setIsEditing] = useState(false);
    const [editedInfo, setEditedInfo] = useState({});

    useEffect(() => {
        fetchUserInfo();
    }, []);

    const fetchUserInfo = async () => {
        try {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            
            if (!token) {
                setError('No authentication token found. Please login again.');
                setLoading(false);
                return;
            }

            const response = await axios.get(`${API_URL}/api/user/profile`, {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            setAccountInfo(response.data);
            setEditedInfo(response.data);
            setLoading(false);
        } catch (err) {
            console.error('Error fetching user info:', err);
            if (err.response?.status === 401) {
                setError('Session expired. Please login again.');
            } else if (err.response?.status === 403) {
                setError('Access denied. Insufficient permissions.');
            } else {
                setError('Failed to fetch account information. Please try again later.');
            }
            setLoading(false);
        }
    };

    const handleEditToggle = () => {
        if (isEditing) {
            // Cancel editing
            setEditedInfo(accountInfo);
        }
        setIsEditing(!isEditing);
    };

    const handleInputChange = (field, value) => {
        setEditedInfo(prev => ({
            ...prev,
            [field]: value
        }));
    };

    const handleSave = async () => {
        try {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            
            const response = await axios.put(
                `${API_URL}/api/user/profile`,
                editedInfo,
                {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                }
            );

            setAccountInfo(response.data);
            setEditedInfo(response.data);
            setIsEditing(false);
        } catch (err) {
            console.error('Error updating profile:', err);
            setError('Failed to update profile. Please try again.');
        }
    };

    if (loading) {
        return (
            <Box display="flex" justifyContent="center" alignItems="center" minHeight="60vh">
                <CircularProgress />
            </Box>
        );
    }

    if (error) {
        return (
            <Container maxWidth="lg" sx={{ py: 4 }}>
                <Alert severity="error" sx={{ mt: 2 }}>{error}</Alert>
            </Container>
        );
    }

    return (
        <div>
            <CssBaseline enableColorScheme />
            <Container maxWidth="lg" sx={{ py: 4 }}>
                <Box display="flex" justifyContent="center" alignItems="center" mb={4}>
                    <Typography
                        variant="h3"
                        fontWeight="bold"
                        color="primary"
                    >
                        Account Information
                    </Typography>
                </Box>

                {accountInfo && (
                    <Paper elevation={3} sx={{ p: 4, borderRadius: 2 }}>
                        {/* Profile Header */}
                        <Box display="flex" alignItems="center" mb={4}>
                            <Avatar
                                sx={{
                                    width: 100,
                                    height: 100,
                                    bgcolor: 'primary.main',
                                    fontSize: 40,
                                    mr: 3
                                }}
                            >
                                {accountInfo.UserName?.charAt(0)?.toUpperCase() || 'U'}
                            </Avatar>
                            <Box flex={1}>
                                <Typography variant="h4" fontWeight="bold">
                                    {accountInfo.UserName}
                                </Typography>
                                <Typography variant="body1" color="text.secondary">
                                    User ID: {accountInfo.UserID}
                                </Typography>
                            </Box>
                            <Box>
                                <Tooltip title={isEditing ? "Cancel" : "Edit Profile"}>
                                    <IconButton 
                                        onClick={handleEditToggle}
                                        color={isEditing ? "error" : "primary"}
                                    >
                                        {isEditing ? <CancelIcon /> : <EditIcon />}
                                    </IconButton>
                                </Tooltip>
                                {isEditing && (
                                    <Tooltip title="Save Changes">
                                        <IconButton 
                                            onClick={handleSave}
                                            color="success"
                                        >
                                            <SaveIcon />
                                        </IconButton>
                                    </Tooltip>
                                )}
                            </Box>
                        </Box>

                        <Divider sx={{ mb: 4 }} />

                        {/* User Information Section */}
                        <SectionTitle title="User Information" />
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Username"
                                    value={isEditing ? editedInfo.UserName : accountInfo.UserName}
                                    onChange={(e) => handleInputChange('UserName', e.target.value)}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: !isEditing,
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Email"
                                    value={isEditing ? editedInfo.Email : accountInfo.Email || 'Not provided'}
                                    onChange={(e) => handleInputChange('Email', e.target.value)}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: !isEditing,
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Full Name"
                                    value={isEditing ? editedInfo.FullName : accountInfo.FullName || 'Not provided'}
                                    onChange={(e) => handleInputChange('FullName', e.target.value)}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: !isEditing,
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Phone"
                                    value={isEditing ? editedInfo.Phone : accountInfo.Phone || 'Not provided'}
                                    onChange={(e) => handleInputChange('Phone', e.target.value)}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: !isEditing,
                                    }}
                                />
                            </Grid>
                        </Grid>

                        {/* Account Details Section */}
                        <SectionTitle title="Account Details" />
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Role"
                                    value={accountInfo.Role || 'User'}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Member Since"
                                    value={accountInfo.CreatedAt ? new Date(accountInfo.CreatedAt).toLocaleDateString() : 'N/A'}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Account Status"
                                    value={accountInfo.Status || 'Active'}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                    sx={{
                                        '& .MuiOutlinedInput-root': {
                                            '& fieldset': {
                                                borderColor: accountInfo.Status === 'Active' ? 'success.main' : 'error.main',
                                            },
                                        },
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Last Login"
                                    value={accountInfo.LastLogin ? new Date(accountInfo.LastLogin).toLocaleString() : 'N/A'}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>
                        </Grid>
                    </Paper>
                )}
            </Container>
        </div>
    );
}

export default Account;
