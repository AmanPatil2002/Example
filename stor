    const handleCopyLink = () => {
        const text = `💑 Success Story: ${selectedStory?.brideName} & ${selectedStory?.groomName} found their perfect match! ${selectedStory?.story?.substring(0, 100)}...`;
        navigator.clipboard.writeText(text);
        setSnackbar({
            open: true,
            message: 'Story copied to clipboard!',
            severity: 'success'
        });
    };

    const filteredStories = () => {
        switch(tabValue) {
            case 0: // All Stories
                return stories;
            case 1: // Most Loved
                return [...stories].sort((a, b) => b.likes - a.likes);
            case 2: // Recent
                return [...stories].sort((a, b) => new Date(b.weddingDate) - new Date(a.weddingDate));
            default:
                return stories;
        }
    };

