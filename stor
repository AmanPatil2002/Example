import { useState } from "react";
import {
  Box,
  Grid,
  Card,
  CardMedia,
  CardContent,
  Typography,
  Button,
  TextField,
  Paper,
  Container,
  IconButton,
  Dialog,
  DialogTitle,
  DialogContent,
  Divider,
  Avatar,
  Stack,
} from "@mui/material";
import FavoriteIcon from '@mui/icons-material/Favorite';
import CalendarMonthIcon from '@mui/icons-material/CalendarMonth';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import FormatQuoteIcon from '@mui/icons-material/FormatQuote';
import CloseIcon from '@mui/icons-material/Close';

const initialStories = [
  {
    couple: "Abhijnan & Kajori",
    city: "Kolkata",
    weddingDate: "12 Feb 2025",
    image:
      "https://images.unsplash.com/photo-1606800052052-a08af7148866?w=900",
    story:
      "I will always be thankful to the team for helping me find my life partner!",
  },
];

export default function SuccessStories() {
  const [stories, setStories] = useState(initialStories);
  const [selectedStory, setSelectedStory] = useState(null);
  const [detailOpen, setDetailOpen] = useState(false);

  const [form, setForm] = useState({
    couple: "",
    city: "",
    weddingDate: "",
    image: "",
    story: "",
  });

  const handleChange = (e) => {
    setForm({
      ...form,
      [e.target.name]: e.target.value,
    });
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    if (
      !form.couple ||
      !form.city ||
      !form.story ||
      !form.image ||
      !form.weddingDate
    ) {
      alert("Please fill all fields");
      return;
    }

    setStories([form, ...stories]);

    setForm({
      couple: "",
      city: "",
      weddingDate: "",
      image: "",
      story: "",
    });
  };

  const handleStoryClick = (story) => {
    setSelectedStory(story);
    setDetailOpen(true);
  };

  return (
    <Box sx={{ bgcolor: "#fafafa", py: { xs: 4, md: 6 } }}>
      <Container maxWidth="lg">
        {/* Header Section */}
        <Box sx={{ textAlign: 'center', mb: 6 }}>
          <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', mb: 1 }}>
            <FavoriteIcon sx={{ color: '#e91e63', fontSize: 32, mr: 1 }} />
            <Typography
              variant="h3"
              fontWeight="bold"
              color="#333"
              sx={{ fontSize: { xs: '1.8rem', md: '2.5rem' } }}
            >
              Success Stories
            </Typography>
          </Box>
          <Typography variant="body1" color="text.secondary" sx={{ maxWidth: 600, mx: 'auto' }}>
            Real couples who found their perfect match
          </Typography>
          <Box sx={{ 
            width: 60, 
            height: 3, 
            backgroundColor: '#e91e63', 
            mx: 'auto', 
            mt: 2,
            borderRadius: 2
          }} />
        </Box>

        {/* Stories Grid - Properly Aligned */}
        <Grid container spacing={3} justifyContent="center">
          {stories.map((item, index) => (
            <Grid item xs={12} sm={6} md={6} key={index}>
              <Card
                onClick={() => handleStoryClick(item)}
                sx={{
                  height: '100%',
                  borderRadius: 3,
                  overflow: "hidden",
                  boxShadow: '0 2px 12px rgba(0,0,0,0.08)',
                  cursor: 'pointer',
                  transition: "all 0.3s ease",
                  "&:hover": {
                    transform: "translateY(-4px)",
                    boxShadow: '0 8px 25px rgba(0,0,0,0.12)',
                  },
                }}
              >
                <CardMedia
                  component="img"
                  height="300"
                  image={item.image}
                  alt={item.couple}
                  sx={{ objectFit: 'cover' }}
                />

                <CardContent sx={{ p: 3 }}>
                  {/* Couple Name */}
                  <Typography variant="h5" fontWeight="bold" gutterBottom>
                    {item.couple}
                  </Typography>

                  {/* City and Date - Properly Aligned */}
                  <Stack 
                    direction="row" 
                    spacing={3} 
                    sx={{ mb: 2 }}
                    alignItems="center"
                  >
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                      <LocationOnIcon sx={{ fontSize: 18, color: '#e91e63' }} />
                      <Typography variant="body2" color="text.secondary">
                        {item.city}
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                      <CalendarMonthIcon sx={{ fontSize: 18, color: '#e91e63' }} />
                      <Typography variant="body2" color="text.secondary">
                        {item.weddingDate}
                      </Typography>
                    </Box>
                  </Stack>

                  {/* Story Quote */}
                  <Box sx={{ position: 'relative', pl: 2 }}>
                    <FormatQuoteIcon 
                      sx={{ 
                        position: 'absolute',
                        top: -5,
                        left: -8,
                        fontSize: 30,
                        color: '#e91e63',
                        opacity: 0.2,
                        transform: 'rotate(180deg)'
                      }} 
                    />
                    <Typography 
                      variant="body1" 
                      sx={{ 
                        fontStyle: 'italic',
                        color: '#555',
                        lineHeight: 1.7
                      }}
                    >
                      {item.story}
                    </Typography>
                  </Box>
                </CardContent>
              </Card>
            </Grid>
          ))}
        </Grid>

        {/* Story Detail Dialog */}
        <Dialog 
          open={detailOpen} 
          onClose={() => setDetailOpen(false)}
          maxWidth="sm"
          fullWidth
          PaperProps={{ sx: { borderRadius: 3 } }}
        >
          {selectedStory && (
            <>
              <DialogTitle sx={{ 
                display: 'flex', 
                justifyContent: 'space-between', 
                alignItems: 'center',
                pb: 1
              }}>
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                  <FavoriteIcon sx={{ color: '#e91e63' }} />
                  <Typography variant="h6" fontWeight="bold">
                    {selectedStory.couple}
                  </Typography>
                </Box>
                <IconButton onClick={() => setDetailOpen(false)} size="small">
                  <CloseIcon />
                </IconButton>
              </DialogTitle>

              <Divider />

              <DialogContent sx={{ pt: 3 }}>
                <Box sx={{ mb: 3, borderRadius: 2, overflow: 'hidden' }}>
                  <img 
                    src={selectedStory.image} 
                    alt={selectedStory.couple}
                    style={{ 
                      width: '100%', 
                      height: 250, 
                      objectFit: 'cover',
                      borderRadius: 8
                    }} 
                  />
                </Box>

                <Stack 
                  direction="row" 
                  spacing={3} 
                  sx={{ mb: 3 }}
                  justifyContent="center"
                >
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                    <LocationOnIcon sx={{ fontSize: 18, color: '#e91e63' }} />
                    <Typography variant="body2" color="text.secondary">
                      {selectedStory.city}
                    </Typography>
                  </Box>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                    <CalendarMonthIcon sx={{ fontSize: 18, color: '#e91e63' }} />
                    <Typography variant="body2" color="text.secondary">
                      {selectedStory.weddingDate}
                    </Typography>
                  </Box>
                </Stack>

                <Box sx={{ position: 'relative', pl: 2 }}>
                  <FormatQuoteIcon 
                    sx={{ 
                      position: 'absolute',
                      top: -10,
                      left: -10,
                      fontSize: 40,
                      color: '#e91e63',
                      opacity: 0.1,
                      transform: 'rotate(180deg)'
                    }} 
                  />
                  <Typography 
                    variant="body1" 
                    sx={{ 
                      fontStyle: 'italic',
                      color: '#555',
                      lineHeight: 1.8,
                      fontSize: '1.05rem'
                    }}
                  >
                    "{selectedStory.story}"
                  </Typography>
                </Box>
              </DialogContent>
            </>
          )}
        </Dialog>

        {/* Form Section - Properly Aligned */}
        <Paper
          elevation={0}
          sx={{
            mt: 6,
            p: { xs: 3, md: 5 },
            borderRadius: 3,
            maxWidth: 800,
            mx: "auto",
            border: '1px solid #e0e0e0',
            backgroundColor: 'white',
          }}
        >
          <Typography
            variant="h4"
            textAlign="center"
            fontWeight="bold"
            color="#333"
            mb={1}
            sx={{ fontSize: { xs: '1.5rem', md: '2rem' } }}
          >
            Share Your Success Story
          </Typography>
        <Box sx={{ 
            width: 60, 
            height: 3, 
            backgroundColor: '#e91e63', 
            mx: 'auto', 
            mb: 4,
            borderRadius: 2
          }} />     
       

          <Box component="form" onSubmit={handleSubmit}>
            <Grid container spacing={2.5}>
              <Grid item xs={12} sm={6}>
                <TextField
                  fullWidth
                  label="Couple Name"
                  name="couple"
                  value={form.couple}
                  onChange={handleChange}
                  placeholder="e.g., Priya & Rahul"
                  variant="outlined"
                />
              </Grid>

              <Grid item xs={12} sm={6}>
                <TextField
                  fullWidth
                  label="City"
                  name="city"
                  value={form.city}
                  onChange={handleChange}
                  placeholder="e.g., Mumbai"
                  variant="outlined"
                />
              </Grid>

              <Grid item xs={12} sm={6} sx={{width: '30%'}}>
                <TextField
                  fullWidth
                  type="date"
                  name="weddingDate"
                  value={form.weddingDate}
                  onChange={handleChange}
                  InputLabelProps={{
                    shrink: true,
                  }}
                  helperText="Enter Wedding Date"
                  variant="outlined"
                />
              </Grid>

              <Grid item xs={12} sm={6}>
                <TextField
                  fullWidth
                  rows={4}
                  label="Image URL"
                  name="image"
                  value={form.image}
                  onChange={handleChange}
                  placeholder="https://example.com/image.jpg"
                  variant="outlined"
                  helperText="Paste a direct image link"
                />
              </Grid>

              <Grid item xs={12}>
                <TextField
                  multiline
                  rows={4}
                  fullWidth
                  label="Your Story"
                  name="story"
                  value={form.story}
                  onChange={handleChange}
                  placeholder="Share your beautiful journey..."
                  variant="outlined"
                />
              </Grid>

              <Grid item xs={12}>
                <Button
                  fullWidth
                  size="large"
                  variant="contained"
                  type="submit"
                  sx={{
                    py: 1.5,
                    backgroundColor: '#e91e63',
                    textTransform: 'none',
                    fontSize: '1rem',
                    fontWeight: 600,
                    borderRadius: 2,
                    '&:hover': {
                      backgroundColor: '#c2185b',
                    }
                  }}
                >
                  Submit Your Story
                </Button>
              </Grid>
            </Grid>
          </Box>
        </Paper>
      </Container>
    </Box>
  );
}
