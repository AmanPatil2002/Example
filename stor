                                        </Typography>
                                    </Box>
                                    
                                    <Box textAlign="center">
                                        <Avatar sx={{ 
                                            width: 100, 
                                            height: 100, 
                                            bgcolor: '#1976d2',
                                            mb: 1,
                                            border: '4px solid #e3f2fd'
                                        }}>
                                            {selectedStory.groomName?.charAt(0)}
                                        </Avatar>
                                        <Typography variant="h6">{selectedStory.groomName}</Typography>
                                        <Chip 
                                            icon={<WcIcon />} 
                                            label={`Groom • ${selectedStory.groomAge} yrs`} 
                                            size="small" 
                                            color="primary" 
                                            sx={{ mt: 1 }}
                                        />
                                    </Box>
                                </Box>
                            </Grid>
                            
