        setSnackbar({
            open: true,
            message: likedStories.has(storyId) ? 'Like removed' : 'Story liked! ❤️',
            severity: 'success'
        });
    };

    const handleStoryClick = (story) => {
        setSelectedStory(story);
        setDetailOpen(true);
    };

    const handleShare = (story) => {
        setSelectedStory(story);
        setShareOpen(true);
    };

    const handleTabChange = (event, newValue) => {
