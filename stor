    // Skeleton loading cards
    const StoryCardSkeleton = () => (
        <Grid item xs={12} sm={6} md={4}>
            <Card>
                <Skeleton variant="rectangular" height={200} />
                <CardContent>
                    <Skeleton variant="text" width="60%" height={30} />
                    <Skeleton variant="text" width="40%" />
                    <Skeleton variant="text" width="80%" />
                    <Skeleton variant="text" width="50%" />
                </CardContent>
            </Card>
        </Grid>
    );

    return (
        <>
            <CssBaseline />
            <Box sx={{ 
                minHeight: '100vh',
                background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                py: { xs: 2, sm: 3, md: 4 },
                px: { xs: 1, sm: 2, md: 0 },
            }}>
                <Container maxWidth="xl">
                    {/* Hero Section */}
                    <HeroSection>
                        <CelebrationIcon sx={{ fontSize: 60, mb: 2 }} />
                        <Typography variant="h4" fontWeight="bold" gutterBottom>
                            Success Stories
                        </Typography>
                        <Typography variant="h6" sx={{ mb: 3, opacity: 0.9 }}>
                            Real couples who found their perfect match on our platform
                        </Typography>
                        <Box sx={{ 
                            display: 'flex', 
                            gap: 2, 
                            justifyContent: 'center', 
                            alignItems: 'center',
                            flexWrap: 'wrap'
                        }}>
                            <Chip 
                                label={`${stories.length}+ Happy Couples`} 
                                icon={<GroupsIcon />}
                                sx={{ 
                                    bgcolor: 'rgba(255,255,255,0.2)', 
                                    color: 'white',
                                    fontWeight: 'bold',
                                    '&:hover': { bgcolor: 'rgba(255,255,255,0.3)' }
                                }} 
                            />
                            <Button
                                variant="contained"
                                size="large"
                                startIcon={<AddIcon />}
                                onClick={() => setSubmitOpen(true)}
                                sx={{
                                    bgcolor: 'white',
                                    color: '#c2185b',
                                    fontWeight: 'bold',
                                    '&:hover': { bgcolor: '#fce4ec' }
                                }}
                            >
                                Share Your Story
                            </Button>
                        </Box>
                    </HeroSection>

                    <StyledPaper elevation={3}>
                        {/* Stats Bar */}
                        <Grid container spacing={2} sx={{ mb: 4 }}>
                            <Grid item xs={4}>
                                <Paper sx={{ 
                                    p: 3, 
                                    textAlign: 'center', 
                                    bgcolor: '#fdf2f8',
                                    borderRadius: 2,
                                    transition: 'transform 0.2s',
                                    '&:hover': { transform: 'scale(1.05)' }
                                }}>
                                    <GroupsIcon sx={{ fontSize: 40, color: '#c2185b' }} />
                                    <Typography variant="h4" fontWeight="bold" color="#c2185b">
                                        {stories.length}+
                                    </Typography>
                                    <Typography variant="body2" color="text.secondary">
                                        Happy Couples
                                    </Typography>
                                </Paper>
                            </Grid>
                            <Grid item xs={4}>
                                <Paper sx={{ 
                                    p: 3, 
                                    textAlign: 'center', 
                                    bgcolor: '#e3f2fd',
                                    borderRadius: 2,
                                    transition: 'transform 0.2s',
                                    '&:hover': { transform: 'scale(1.05)' }
                                }}>
                                    <FavoriteIcon sx={{ fontSize: 40, color: '#1976d2' }} />
                                    <Typography variant="h4" fontWeight="bold" color="#1976d2">
                                        {totalLikes}+
                                    </Typography>
                                    <Typography variant="body2" color="text.secondary">
                                        Total Likes
                                    </Typography>
                                </Paper>
                            </Grid>
                            <Grid item xs={4}>
                                <Paper sx={{ 
                                    p: 3, 
                                    textAlign: 'center', 
                                    bgcolor: '#f3e5f5',
                                    borderRadius: 2,
                                    transition: 'transform 0.2s',
                                    '&:hover': { transform: 'scale(1.05)' }
                                }}>
                                    <AutoStoriesIcon sx={{ fontSize: 40, color: '#7b1fa2' }} />
                                    <Typography variant="h4" fontWeight="bold" color="#7b1fa2">
                                        100%
                                    </Typography>
                                    <Typography variant="body2" color="text.secondary">
                                        Success Rate
                                    </Typography>
                                </Paper>
                            </Grid>
                        </Grid>

                        {/* Tabs */}
                        <Tabs 
                            value={tabValue} 
                            onChange={handleTabChange} 
                            centered 
                            sx={{ mb: 4 }}
                            textColor="secondary"
                            indicatorColor="secondary"
                            variant="fullWidth"
                        >
                            <Tab icon={<AutoStoriesIcon />} label="All Stories" />
                            <Tab icon={<FavoriteIcon />} label="Most Loved" />
                            <Tab icon={<CelebrationIcon />} label="Recent Weddings" />
                        </Tabs>

                        {/* Stories Grid */}
                        {loading ? (
                            <Grid container spacing={3}>
                                {[...Array(6)].map((_, index) => (
                                    <StoryCardSkeleton key={index} />
                                ))}
                            </Grid>
                        ) : filteredStories().length === 0 ? (
                            <Box textAlign="center" py={8}>
                                <EmojiEmotionsIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
                                <Typography variant="h5" color="text.secondary" gutterBottom>
                                    No Stories Yet
                                </Typography>
                                <Typography variant="body1" color="text.secondary" gutterBottom>
                                    Be the first to share your beautiful success story!
                                </Typography>
                                <Button
                                    variant="contained"
                                    size="large"
                                    startIcon={<AddIcon />}
                                    onClick={() => setSubmitOpen(true)}
                                    sx={{ 
                                        mt: 2,
                                        background: 'linear-gradient(45deg, #c2185b 30%, #e91e63 90%)',
                                    }}
                                >
                                    Share Your Story
                                </Button>
                            </Box>
                        ) : (
                            <Grid container spacing={3}>
                                {filteredStories().map((story) => (
                                    <Grid item xs={12} sm={6} md={4} key={story.id}>
                                        <StoryCard onClick={() => handleStoryClick(story)}>
                                            <LikeButton
                                                isliked={likedStories.has(story.id) ? 1 : 0}
                                                onClick={(e) => handleLike(story.id, e)}
                                                size="small"
                                            >
                                                {likedStories.has(story.id) ? 
                                                    <FavoriteIcon /> : 
                                                    <FavoriteBorderIcon />
                                                }
                                            </LikeButton>
                                            <CardMedia
                                                component="div"
                                                sx={{
                                                    height: 200,
                                                    background: 'linear-gradient(135deg, #c2185b 0%, #e91e63 50%, #f06292 100%)',
                                                    display: 'flex',
                                                    alignItems: 'center',
                                                    justifyContent: 'center',
                                                    position: 'relative',
                                                }}
                                            >
                                                <FavoriteIcon sx={{ 
                                                    fontSize: 100, 
                                                    color: 'rgba(255,255,255,0.2)',
                                                    position: 'absolute',
                                                }} />
                                                <Box textAlign="center" sx={{ position: 'relative', zIndex: 1 }}>
                                                    <AvatarGroup max={2} sx={{ justifyContent: 'center', mb: 2 }}>
                                                        <Avatar sx={{ 
                                                            bgcolor: 'white', 
                                                            color: '#c2185b',
                                                            width: 60, 
                                                            height: 60,
                                                            border: '3px solid #c2185b',
                                                            fontWeight: 'bold'
                                                        }}>
                                                            {story.brideName?.charAt(0)}
                                                        </Avatar>
                                                        <Avatar sx={{ 
                                                            bgcolor: 'white', 
                                                            color: '#1976d2',
                                                            width: 60, 
                                                            height: 60,
                                                            border: '3px solid #1976d2',
                                                            fontWeight: 'bold'
                                                        }}>
                                                            {story.groomName?.charAt(0)}
                                                        </Avatar>
                                                    </AvatarGroup>
                                                    <Typography variant="body2" sx={{ color: 'white', opacity: 0.9 }}>
                                                        📍 {story.location}
                                                    </Typography>
                                                </Box>
                                            </CardMedia>
                                            <CardContent>
                                                <Typography variant="h6" gutterBottom sx={{ color: '#c2185b' }}>
                                                    {story.brideName} & {story.groomName}
                                                </Typography>
                                                <Box sx={{ display: 'flex', alignItems: 'center', mb: 1 }}>
                                                    <CalendarMonthIcon fontSize="small" sx={{ mr: 0.5, color: 'text.secondary' }} />
                                                    <Typography variant="body2" color="text.secondary">
                                                        {new Date(story.weddingDate).toLocaleDateString('en-US', { 
                                                            year: 'numeric', 
                                                            month: 'long', 
                                                            day: 'numeric' 
                                                        })}
                                                    </Typography>
                                                </Box>
                                                <Typography 
                                                    variant="body2" 
                                                    color="text.secondary"
                                                    sx={{
                                                        overflow: 'hidden',
                                                        textOverflow: 'ellipsis',
                                                        display: '-webkit-box',
                                                        WebkitLineClamp: 3,
                                                        WebkitBoxOrient: 'vertical',
                                                        mb: 2,
                                                        lineHeight: 1.6,
                                                    }}
                                                >
                                                    {story.story}
                                                </Typography>
                                                <Box sx={{ 
                                                    display: 'flex', 
                                                    justifyContent: 'space-between', 
                                                    alignItems: 'center' 
                                                }}>
                                                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                                                        <IconButton 
                                                            size="small"
                                                            onClick={(e) => handleLike(story.id, e)}
                                                        >
                                                            {likedStories.has(story.id) ? 
                                                                <FavoriteIcon sx={{ color: '#e91e63' }} /> : 
                                                                <FavoriteBorderIcon />
                                                            }
                                                        </IconButton>
                                                        <Typography variant="body2" color="text.secondary">
                                                            {story.likes + (likedStories.has(story.id) ? 1 : 0)}
                                                        </Typography>
                                                    </Box>
                                                    <Box>
                                                        <Rating value={story.rating} size="small" readOnly />
                                                        <IconButton 
                                                            size="small"
                                                            onClick={(e) => {
                                                                e.stopPropagation();
                                                                handleShare(story);
                                                            }}
                                                        >
                                                            <ShareIcon fontSize="small" />
                                                        </IconButton>
                                                    </Box>
                                                </Box>
                                            </CardContent>
                                        </StoryCard>
                                    </Grid>
                                ))}
                            </Grid>
                        )}

                        {/* Call to Action */}
                        <Box textAlign="center" mt={6} p={5} sx={{ 
                            bgcolor: '#fdf2f8', 
                            borderRadius: 2,
                            border: '2px dashed #e91e63',
                            position: 'relative',
                            overflow: 'hidden',
                        }}>
                            <FavoriteIcon sx={{ 
                                position: 'absolute',
                                top: -20,
                                right: -20,
                                fontSize: 100,
                                color: 'rgba(233, 30, 99, 0.1)',
                            }} />
                            <Typography variant="h5" gutterBottom sx={{ color: '#c2185b', fontWeight: 'bold' }}>
                                Found Your Perfect Match? 💑
                            </Typography>
                            <Typography variant="body1" color="text.secondary" gutterBottom>
                                We'd love to hear your story! Share your journey and inspire others to find their soulmate.
                            </Typography>
                            <Button
                                variant="contained"
                                size="large"
                                startIcon={<FavoriteIcon />}
                                onClick={() => setSubmitOpen(true)}
                                sx={{
                                    mt: 2,
                                    px: 4,
                                    py: 1.5,
                                    fontSize: '1.1rem',
                                    background: 'linear-gradient(45deg, #c2185b 30%, #e91e63 90%)',
                                    '&:hover': {
                                        background: 'linear-gradient(45deg, #ad1457 30%, #c2185b 90%)',
                                    }
                                }}
                            >
                                Share Your Success Story
                            </Button>
                        </Box>
                    </StyledPaper>
                </Container>
            </Box>

            {/* Scroll to Top Button */}
            {showScrollTop && (
                <ScrollToTopButton onClick={scrollToTop} size="small">
                    <ArrowUpwardIcon />
                </ScrollToTopButton>
            )}

            {/* Dialogs */}
            <StoryDetailDialog />
            <ShareDialog />
            <SubmitStoryDialog />

            {/* Snackbar for notifications */}
            <Snackbar
                open={snackbar.open}
                autoHideDuration={4000}
                onClose={() => setSnackbar(prev => ({ ...prev, open: false }))}
                anchorOrigin={{ vertical: 'top', horizontal: 'right' }}
            >
                <Alert 
                    onClose={() => setSnackbar(prev => ({ ...prev, open: false }))} 
                    severity={snackbar.severity}
                    variant="filled"
                    sx={{ width: '100%' }}
                >
                    {snackbar.message}
                </Alert>
            </Snackbar>
        </>
    );
}
