import * as React from "react";
import AppBar from "@mui/material/AppBar";
import Box from "@mui/material/Box";
import Toolbar from "@mui/material/Toolbar";
import IconButton from "@mui/material/IconButton";
import Typography from "@mui/material/Typography";
import Menu from "@mui/material/Menu";
import MenuIcon from "@mui/icons-material/Menu";
import Container from "@mui/material/Container";
import Avatar from "@mui/material/Avatar";
import Button from "@mui/material/Button";
import Tooltip from "@mui/material/Tooltip";
import MenuItem from "@mui/material/MenuItem";
import { useNavigate } from "react-router-dom";
import FavoriteIcon from "@mui/icons-material/Favorite";
import KeyboardArrowDownIcon from "@mui/icons-material/KeyboardArrowDown";

function Navbar() {
  const [anchorElNav, setAnchorElNav] = React.useState(null);
  const [anchorElUser, setAnchorElUser] = React.useState(null);

  const navigate = useNavigate();

  const handleOpenNavMenu = (event) => {
    setAnchorElNav(event.currentTarget);
  };

  const handleOpenUserMenu = (event) => {
    setAnchorElUser(event.currentTarget);
  };

  const handleCloseNavMenu = () => {
    setAnchorElNav(null);
  };

  const handleCloseUserMenu = () => {
    setAnchorElUser(null);
  };

  const handleLogout = () => {
    localStorage.removeItem("token");
    handleCloseUserMenu();
    navigate("/");
  };

  return (
    <AppBar 
      position="sticky" 
      elevation={0}
      sx={{ 
        backgroundColor: "rgb(163, 65, 65)",
        borderBottom: "1px solid rgba(255,255,255,0.1)",
      }}
    >
      <Container maxWidth="xl">
        <Toolbar disableGutters sx={{ height: 70 }}>
          {/* Desktop Logo */}
          <Box
            sx={{
              mr: 4,
              display: { xs: "none", md: "flex" },
              alignItems: "center",
              gap: 1,
              cursor: "pointer",
            }}
            onClick={() => navigate("/home")}
          >
            <FavoriteIcon sx={{ color: "white", fontSize: 24 }} />
            <Typography
              variant="h6"
              noWrap
              sx={{
                fontFamily: '"Georgia", serif',
                fontWeight: 700,
                letterSpacing: "0.5px",
                color: "white",
                textDecoration: "none",
                fontSize: "1.5rem",
              }}
            >
              Sathi
            </Typography>
          </Box>

          {/* Mobile Menu */}
          <Box sx={{ flexGrow: 1, display: { xs: "flex", md: "none" } }}>
            <IconButton
              size="large"
              onClick={handleOpenNavMenu}
              sx={{ color: "white" }}
            >
              <MenuIcon />
            </IconButton>

            <Menu
              id="nav-menu"
              anchorEl={anchorElNav}
              anchorOrigin={{
                vertical: "bottom",
                horizontal: "left",
              }}
              transformOrigin={{
                vertical: "top",
                horizontal: "left",
              }}
              open={Boolean(anchorElNav)}
              onClose={handleCloseNavMenu}
              PaperProps={{
                sx: {
                  mt: 1.5,
                  borderRadius: 2,
                  boxShadow: "0 4px 20px rgba(0,0,0,0.15)",
                  minWidth: 200,
                }
              }}
            >
              <MenuItem
                onClick={() => {
                  handleCloseNavMenu();
                  navigate("/home");
                }}
                sx={{ py: 1.5 }}
              >
                <Typography sx={{ fontWeight: 500, color: "#333" }}>Home</Typography>
              </MenuItem>

              <MenuItem
                onClick={() => {
                  handleCloseNavMenu();
                  navigate("/contact");
                }}
                sx={{ py: 1.5 }}
              >
                <Typography sx={{ fontWeight: 500, color: "#333" }}>Contact Us</Typography>
              </MenuItem>
            </Menu>
          </Box>

          {/* Mobile Logo */}
          <Box
            sx={{
              display: { xs: "flex", md: "none" },
              alignItems: "center",
              gap: 1,
              flexGrow: 1,
              cursor: "pointer",
            }}
            onClick={() => navigate("/home")}
          >
            <Typography
              variant="h5"
              noWrap
              sx={{
                fontFamily: '"Georgia", serif',
                fontWeight: 700,
                letterSpacing: "0.5px",
                color: "white",
              }}
            >
              Sathi
            </Typography>
          </Box>

          {/* Desktop Navigation */}
          <Box 
            sx={{ 
              flexGrow: 1, 
              display: { xs: "none", md: "flex" }, 
              gap: 0.5,
            }}
          >
            <Button
              onClick={() => navigate("/home")}
              sx={{
                color: "white",
                fontWeight: 500,
                fontSize: "0.95rem",
                textTransform: "none",
                px: 3,
                py: 1,
                borderRadius: "8px",
                '&:hover': {
                  backgroundColor: "rgba(255,255,255,0.1)",
                },
              }}
            >
              Home
            </Button>

            <Button
              onClick={() => navigate("/contact")}
              sx={{
                color: "rgba(255,255,255,0.9)",
                fontWeight: 500,
                fontSize: "0.95rem",
                textTransform: "none",
                px: 3,
                py: 1,
                borderRadius: "8px",
                '&:hover': {
                  backgroundColor: "rgba(255,255,255,0.1)",
                  color: "white",
                },
              }}
            >
              Contact Us
            </Button>
          </Box>

          {/* User Profile Section */}
          <Box sx={{ flexGrow: 0 }}>
            <Tooltip title="Account settings">
              <IconButton 
                onClick={handleOpenUserMenu} 
                sx={{ 
                  p: 0.5,
                  border: "2px solid rgba(255,255,255,0.3)",
                  borderRadius: "12px",
                  transition: "all 0.2s ease",
                  '&:hover': {
                    border: "2px solid rgba(255,255,255,0.6)",
                    backgroundColor: "rgba(255,255,255,0.1)",
                  }
                }}
              >
                <Box sx={{ display: "flex", alignItems: "center", gap: 1, px: 1 }}>
                  <Avatar 
                    sx={{ 
                      width: 32, 
                      height: 32, 
                      bgcolor: "rgba(255,255,255,0.2)",
                      fontSize: "0.9rem",
                      fontWeight: 600,
                      color: "white",
                    }}
                  >
                    U
                  </Avatar>
                  <Typography 
                    sx={{ 
                      color: "white", 
                      fontSize: "0.9rem", 
                      fontWeight: 500,
                      display: { xs: "none", sm: "block" }
                    }}
                  >
                    Profile
                  </Typography>
                  <KeyboardArrowDownIcon 
                    sx={{ 
                      color: "white", 
                      fontSize: 20,
                      display: { xs: "none", sm: "block" }
                    }} 
                  />
                </Box>
              </IconButton>
            </Tooltip>

            <Menu
              id="user-menu"
              anchorEl={anchorElUser}
              anchorOrigin={{
                vertical: "bottom",
                horizontal: "right",
              }}
              transformOrigin={{
                vertical: "top",
                horizontal: "right",
              }}
              open={Boolean(anchorElUser)}
              onClose={handleCloseUserMenu}
              PaperProps={{
                sx: {
                  mt: 1.5,
                  boxShadow: "0 4px 20px rgba(0,0,0,0.15)",
                  borderRadius: 2,
                  minWidth: 200,
                  overflow: "visible",
                }
              }}
            >
              <MenuItem
                onClick={() => {
                  handleCloseUserMenu();
                  navigate("/profile");
                }}
                sx={{ py: 1.5 }}
              >
                <Typography sx={{ fontWeight: 500, color: "#333" }}>
                  My Profile
                </Typography>
              </MenuItem>

              <MenuItem 
                onClick={handleCloseUserMenu}
                sx={{ py: 1.5 }}
              >
                <Typography sx={{ fontWeight: 500, color: "#333" }}>
                  Account Settings
                </Typography>
              </MenuItem>

              <Box sx={{ borderTop: "1px solid #eee", my: 0.5 }} />

              <MenuItem 
                onClick={handleLogout}
                sx={{ py: 1.5 }}
              >
                <Typography sx={{ fontWeight: 600, color: "#d32f2f" }}>
                  Log Out
                </Typography>
              </MenuItem>
            </Menu>
          </Box>
        </Toolbar>
      </Container>
    </AppBar>
  );
}

export default Navbar;
