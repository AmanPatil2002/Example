import Paper from '@mui/material/Paper';
import { useState, useEffect } from "react";
import axios from "axios";
import {
    Box,
    Typography,
    Avatar,
    Divider,
    Grid,
    Chip,
    CircularProgress,
    Alert
} from "@mui/material";
import PersonIcon from '@mui/icons-material/Person';
import EmailIcon from '@mui/icons-material/Email';
import BadgeIcon from '@mui/icons-material/Badge';

const API_URL = import.meta.env.VITE_API_URL;

export default function Account() {
    const [currentUser, setCurrentUser] = useState(null);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState(null);

    useEffect(() => {
        fetchCurrentUser();
    }, []);

    const fetchCurrentUser = async () => {
        try {
            setLoading(true);
            const userId = localStorage.getItem("userId");
            const userEmail = localStorage.getItem("userEmail");
            
            const res = await axios.get(`${API_URL}/auth/user`);
            const userData = Array.isArray(res.data)
                ? res.data
                : res.data.users || [];

            // Find the current logged-in user
            const currentUserData = userData.find(
                (user) => user.UserID === userId || user.UserEmail === userEmail
            );

            if (currentUserData) {
                setCurrentUser(currentUserData);
            } else {
                setError("User information not found");
            }
        } catch (err) {
            console.log(err.response?.data || err.message);
            setError("Failed to fetch user information");
        } finally {
            setLoading(false);
        }
    };

    if (loading) {
        return (
            <Box className="flex justify-center items-center h-64">
                <CircularProgress />
            </Box>
        );
    }

    if (error) {
        return (
            <Box className="p-6">
                <Alert severity="error">{error}</Alert>
            </Box>
        );
    }

    if (!currentUser) {
        return (
            <Box className="p-6">
                <Alert severity="warning">No user information available</Alert>
            </Box>
        );
    }

    return (
        <Box className="p-6 max-w-2xl mx-auto">
            <Typography
                variant="h4"
                align="center"
                fontWeight="bold"
                gutterBottom
                className="mb-8 text-gray-800"
            >
                My Account
            </Typography>

            <Paper elevation={3} className="p-8 rounded-lg">
                {/* User Avatar Section */}
                <Box className="flex flex-col items-center mb-6">
                    <Avatar
                        sx={{
                            width: 100,
                            height: 100,
                            bgcolor: 'primary.main',
                            fontSize: '2.5rem',
                            mb: 2
                        }}
                    >
                        {currentUser.UserName?.charAt(0)?.toUpperCase() || 'U'}
                    </Avatar>
                    <Typography variant="h5" fontWeight="bold" className="text-gray-800">
                        {currentUser.UserName}
                    </Typography>
                    <Chip
                        label={currentUser.Role || "User"}
                        color="primary"
                        size="small"
                        className="mt-2"
                    />
                </Box>

                <Divider className="my-6" />

                {/* User Details Section */}
                <Grid container spacing={3}>
                    {/* Username */}
                    <Grid item xs={12}>
                        <Box className="flex items-center p-4 bg-gray-50 rounded-lg">
                            <PersonIcon className="text-blue-600 mr-3" />
                            <Box>
                                <Typography variant="caption" className="text-gray-500">
                                    Username
                                </Typography>
                                <Typography variant="body1" fontWeight="medium" className="text-gray-800">
                                    {currentUser.UserName}
                                </Typography>
                            </Box>
                        </Box>
                    </Grid>

                    {/* Email */}
                    <Grid item xs={12}>
                        <Box className="flex items-center p-4 bg-gray-50 rounded-lg">
                            <EmailIcon className="text-blue-600 mr-3" />
                            <Box>
                                <Typography variant="caption" className="text-gray-500">
                                    Email Address
                                </Typography>
                                <Typography variant="body1" fontWeight="medium" className="text-gray-800">
                                    {currentUser.UserEmail}
                                </Typography>
                            </Box>
                        </Box>
                    </Grid>

                    {/* User ID */}
                    <Grid item xs={12}>
                        <Box className="flex items-center p-4 bg-gray-50 rounded-lg">
                            <BadgeIcon className="text-blue-600 mr-3" />
                            <Box>
                                <Typography variant="caption" className="text-gray-500">
                                    User ID
                                </Typography>
                                <Typography variant="body1" fontWeight="medium" className="text-gray-800">
                                    {currentUser.UserID}
                                </Typography>
                            </Box>
                        </Box>
                    </Grid>

                    {/* Role */}
                    {currentUser.Role && (
                        <Grid item xs={12}>
                            <Box className="flex items-center p-4 bg-gray-50 rounded-lg">
                                <PersonIcon className="text-blue-600 mr-3" />
                                <Box>
                                    <Typography variant="caption" className="text-gray-500">
                                        Role
                                    </Typography>
                                    <Typography variant="body1" fontWeight="medium" className="text-gray-800">
                                        {currentUser.Role}
                                    </Typography>
                                </Box>
                            </Box>
                        </Grid>
                    )}
                </Grid>
            </Paper>
        </Box>
    );
}
