import CssBaseline from '@mui/material/CssBaseline';
import {
    Box,
    Container,
    Grid,
    TextField,
    Typography,
    Avatar,
    Divider,
    Paper,
} from "@mui/material";

import { useState, useEffect } from 'react';
import axios from "axios";

const API_URL = import.meta.env.VITE_API_URL;

const SectionTitle = ({ title }) => (
    <Typography
        variant="h5"
        sx={{
            mt: 4,
            mb: 2,
            color: "primary.main",
            fontWeight: "bold",
        }}
    >
        {title}
    </Typography>
);

function Account() {
    const [accountInfo, setAccountInfo] = useState(null);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        // First try to get user info from local storage
        const storedUser = localStorage.getItem('user');
        
        if (storedUser) {
            try {
                const parsedUser = JSON.parse(storedUser);
                // Set basic info from local storage immediately
                setAccountInfo({
                    UserName: parsedUser.username || parsedUser.UserName || 'User',
                    UserEmail: parsedUser.email || parsedUser.UserEmail || 'No email',
                    Role: parsedUser.role || parsedUser.Role || 'User',
                    UserID: parsedUser.id || parsedUser.UserID
                });
                
                // Optionally fetch full details from API
                showAccount();
            } catch (error) {
                console.error("Error parsing stored user:", error);
                showAccount();
            }
        } else {
            // If no local storage data, fetch from API
            showAccount();
        }
    }, []);

    const showAccount = async () => {
        try {
            const res = await axios.get(`${API_URL}/auth/user`);
            console.log("API Response:", res.data);
            
            // Update account info with full API response
            setAccountInfo(res.data);
            
            // Optionally update local storage with fresh data
            const updatedUser = {
                username: res.data.UserName,
                email: res.data.UserEmail,
                role: res.data.Role,
                id: res.data.UserID
            };
            localStorage.setItem('user', JSON.stringify(updatedUser));
            
            setLoading(false);
        } catch (err) {
            console.log("Error details:", err.response?.data || err.message);
            setLoading(false);
        }
    };

    return (
        <div>
            <CssBaseline enableColorScheme />
            <Container maxWidth="lg" sx={{ py: 4 }}>
                <Box display="flex" justifyContent="center" alignItems="center" mb={4}>
                    <Typography
                        variant="h3"
                        fontWeight="bold"
                        color="primary"
                    >
                        Account Information
                    </Typography>
                </Box>

                {loading ? (
                    <Box display="flex" justifyContent="center" p={4}>
                        <Typography variant="h6">Loading...</Typography>
                    </Box>
                ) : accountInfo ? (
                    <Paper elevation={3} sx={{ p: 4, borderRadius: 2 }}>
                        {/* Profile Header */}
                        <Box display="flex" alignItems="center" mb={4}>
                            <Avatar
                                sx={{
                                    width: 100,
                                    height: 100,
                                    bgcolor: 'primary.main',
                                    fontSize: 40,
                                    mr: 3
                                }}
                            >
                                {accountInfo.UserName?.charAt(0)?.toUpperCase() || 'U'}
                            </Avatar>
                            <Box>
                                <Typography variant="h4" fontWeight="bold">
                                    {accountInfo.UserName || 'User'}
                                </Typography>
                                <Typography variant="body1" color="text.secondary">
                                    {accountInfo.UserEmail || 'No email'}
                                </Typography>
                            </Box>
                        </Box>

                        <Divider sx={{ mb: 4 }} />

                        {/* User Information Section */}
                        <SectionTitle title="User Information" />
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Username"
                                    value={accountInfo.UserName || ''}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Email"
                                    value={accountInfo.UserEmail || ''}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>
                        </Grid>

                        {/* Account Details Section */}
                        <SectionTitle title="Account Details" />
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Role"
                                    value={accountInfo.Role || 'User'}
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>

                            <Grid item xs={12} md={6}>
                                <TextField
                                    fullWidth
                                    label="Account Status"
                                    value='Active'
                                    variant="outlined"
                                    InputProps={{
                                        readOnly: true,
                                    }}
                                />
                            </Grid>
                        </Grid>
                    </Paper>
                ) : (
                    <Box display="flex" justifyContent="center" p={4}>
                        <Typography variant="h6" color="error">
                            No account information found. Please log in again.
                        </Typography>
                    </Box>
                )}
            </Container>
        </div>
    );
}

export default Account;
