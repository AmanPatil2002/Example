import {
    Box,
    Container,
    CssBaseline,
    Grid,
    Paper,
    Typography,
    Divider,
    Card,
    CardContent,
    CardMedia,
    Alert,
    Snackbar,
    Avatar,
    Chip,
    Button,
    TextField,
    InputAdornment,
    IconButton,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    Skeleton,
    Fab,
    Tooltip,
    MenuItem,
    Select,
    FormControl,
    InputLabel,
    CircularProgress,
} from "@mui/material";
import { styled } from "@mui/material/styles";
import SearchIcon from '@mui/icons-material/Search';
import FilterListIcon from '@mui/icons-material/FilterList';
import PersonIcon from '@mui/icons-material/Person';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import SchoolIcon from '@mui/icons-material/School';
import WorkIcon from '@mui/icons-material/Work';
import FavoriteIcon from '@mui/icons-material/Favorite';
import FavoriteBorderIcon from '@mui/icons-material/FavoriteBorder';
import VisibilityIcon from '@mui/icons-material/Visibility';
import ArrowUpwardIcon from '@mui/icons-material/ArrowUpward';
import CloseIcon from '@mui/icons-material/Close';
import { useState, useEffect, useCallback } from "react";
import { useNavigate } from "react-router-dom";
import axios from "axios";
import dayjs from 'dayjs';

const API_URL = import.meta.env.VITE_API_URL;

const StyledPaper = styled(Paper)(({ theme }) => ({
    padding: theme.spacing(3),
    borderRadius: 16,
    boxShadow: '0 8px 32px rgba(0,0,0,0.1)',
    [theme.breakpoints.down('sm')]: {
        padding: theme.spacing(2),
        borderRadius: 12,
    },
}));

const ProfileCard = styled(Card)(({ theme }) => ({
    height: '100%',
    transition: 'transform 0.3s, box-shadow 0.3s',
    cursor: 'pointer',
    position: 'relative',
    overflow: 'visible',
    '&:hover': {
        transform: 'translateY(-8px)',
        boxShadow: '0 12px 40px rgba(0,0,0,0.15)',
    },
}));

const LikeButton = styled(IconButton)(({ theme, isliked }) => ({
    position: 'absolute',
    top: 10,
    right: 10,
    backgroundColor: 'white',
    boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
    '&:hover': {
        backgroundColor: '#fce4ec',
    },
    color: isliked === 'true' ? '#e91e63' : 'grey',
}));

const ScrollToTopButton = styled(Fab)(({ theme }) => ({
    position: 'fixed',
    bottom: 20,
    right: 20,
    backgroundColor: '#c2185b',
    color: 'white',
    '&:hover': {
        backgroundColor: '#ad1457',
    },
}));

export default function ViewProfiles() {
    const navigate = useNavigate();
    const [profiles, setProfiles] = useState([]);
    const [filteredProfiles, setFilteredProfiles] = useState([]);
    const [loading, setLoading] = useState(true);
    const [snackbar, setSnackbar] = useState({ open: false, message: '', severity: 'success' });
    const [selectedProfile, setSelectedProfile] = useState(null);
    const [detailOpen, setDetailOpen] = useState(false);
    const [showScrollTop, setShowScrollTop] = useState(false);
    const [likedProfiles, setLikedProfiles] = useState(new Set());
    
    // Filter states
    const [searchTerm, setSearchTerm] = useState('');
    const [filters, setFilters] = useState({
        gender: '',
        religion: '',
        language: '',
        minAge: '',
        maxAge: '',
        maritalStatus: '',
    });
    const [showFilters, setShowFilters] = useState(false);

    // Get current user ID from localStorage or context
    const currentUserId = localStorage.getItem('userId') || sessionStorage.getItem('userId');

    useEffect(() => {
        fetchProfiles();
        window.addEventListener('scroll', handleScroll);
        return () => window.removeEventListener('scroll', handleScroll);
    }, []);

    const handleScroll = () => {
        setShowScrollTop(window.pageYOffset > 300);
    };

    const scrollToTop = () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const fetchProfiles = async () => {
        setLoading(true);
        try {
            const res = await axios.get(`${API_URL}/profiles`);
            // Filter out the current user's profile
            const otherProfiles = res.data.filter(profile => profile._id !== currentUserId);
            setProfiles(otherProfiles);
            setFilteredProfiles(otherProfiles);
        } catch (err) {
            console.error('Error fetching profiles:', err);
            setSnackbar({ 
                open: true, 
                message: 'Error loading profiles. Please try again.', 
                severity: 'error' 
            });
        } finally {
            setLoading(false);
        }
    };

    const applyFilters = useCallback(() => {
        let filtered = [...profiles];

        // Search filter
        if (searchTerm) {
            const term = searchTerm.toLowerCase();
            filtered = filtered.filter(profile => 
                profile.name?.toLowerCase().includes(term) ||
                profile.occupation?.toLowerCase().includes(term) ||
                profile.education?.toLowerCase().includes(term) ||
                profile.city?.toLowerCase().includes(term)
            );
        }

        // Gender filter
        if (filters.gender) {
            filtered = filtered.filter(profile => profile.gender === filters.gender);
        }

        // Religion filter
        if (filters.religion) {
            filtered = filtered.filter(profile => profile.religion === filters.religion);
        }

        // Language filter
        if (filters.language) {
            filtered = filtered.filter(profile => profile.language === filters.language);
        }

        // Age range filter
        if (filters.minAge) {
            filtered = filtered.filter(profile => profile.age >= parseInt(filters.minAge));
        }
        if (filters.maxAge) {
            filtered = filtered.filter(profile => profile.age <= parseInt(filters.maxAge));
        }

        // Marital status filter
        if (filters.maritalStatus) {
            filtered = filtered.filter(profile => profile.status === filters.maritalStatus);
        }

        setFilteredProfiles(filtered);
    }, [profiles, searchTerm, filters]);

    useEffect(() => {
        applyFilters();
    }, [applyFilters]);

    const handleLike = (profileId, event) => {
        event.stopPropagation();
        setLikedProfiles(prev => {
            const newLikes = new Set(prev);
            if (newLikes.has(profileId)) {
                newLikes.delete(profileId);
            } else {
                newLikes.add(profileId);
            }
            return newLikes;
        });
        
        setSnackbar({
            open: true,
            message: likedProfiles.has(profileId) ? 'Profile removed from favorites' : 'Profile added to favorites',
            severity: 'success'
        });
    };

    const handleProfileClick = (profile) => {
        setSelectedProfile(profile);
        setDetailOpen(true);
    };

    const handleFilterChange = (field) => (event) => {
        setFilters(prev => ({
            ...prev,
            [field]: event.target.value
        }));
    };

    const clearFilters = () => {
        setSearchTerm('');
        setFilters({
            gender: '',
            religion: '',
            language: '',
            minAge: '',
            maxAge: '',
            maritalStatus: '',
        });
    };

    const ProfileDetailDialog = () => (
        <Dialog 
            open={detailOpen} 
            onClose={() => setDetailOpen(false)}
            maxWidth="md"
            fullWidth
        >
            {selectedProfile && (
                <>
                    <DialogTitle sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <Typography variant="h5" fontWeight="bold">
                            {selectedProfile.name}'s Profile
                        </Typography>
                        <IconButton onClick={() => setDetailOpen(false)}>
                            <CloseIcon />
                        </IconButton>
                    </DialogTitle>
                    <DialogContent dividers>
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={4}>
                                <Avatar
                                    src={selectedProfile.image ? `${API_URL}/uploads/${selectedProfile.image.split(',')[0]}` : undefined}
                                    alt={selectedProfile.name}
                                    sx={{ 
                                        width: '100%', 
                                        height: 'auto', 
                                        aspectRatio: '1/1',
                                        borderRadius: 2,
                                        mb: 2
                                    }}
                                    variant="rounded"
                                >
                                    <PersonIcon sx={{ fontSize: 100 }} />
                                </Avatar>
                                <Typography variant="h6" align="center">
                                    {selectedProfile.name}
                                </Typography>
                                <Typography variant="body1" color="text.secondary" align="center">
                                    {selectedProfile.age} years • {selectedProfile.height} cm
                                </Typography>
                            </Grid>
                            <Grid item xs={12} md={8}>
                                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                    <InfoIcon color="primary" /> Personal Information
                                </Typography>
                                <Grid container spacing={2}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Religion</Typography>
                                        <Typography variant="body1">{selectedProfile.religion}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Mother Tongue</Typography>
                                        <Typography variant="body1">{selectedProfile.language}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Marital Status</Typography>
                                        <Typography variant="body1">{selectedProfile.status}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Location</Typography>
                                        <Typography variant="body1">
                                            <LocationOnIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                            {selectedProfile.address || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                <Divider sx={{ my: 2 }} />

                                <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                    <SchoolIcon color="primary" /> Education & Career
                                </Typography>
                                <Grid container spacing={2}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Education</Typography>
                                        <Typography variant="body1">{selectedProfile.education || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Occupation</Typography>
                                        <Typography variant="body1">{selectedProfile.occupation || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Company</Typography>
                                        <Typography variant="body1">{selectedProfile.company || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Annual Income</Typography>
                                        <Typography variant="body1">
                                            {selectedProfile.income ? `₹${selectedProfile.income}` : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                {selectedProfile.detail && (
                                    <>
                                        <Divider sx={{ my: 2 }} />
                                        <Typography variant="h6" gutterBottom sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                                            <FavoriteIcon color="primary" /> About Me
                                        </Typography>
                                        <Typography variant="body1" sx={{ whiteSpace: 'pre-line' }}>
                                            {selectedProfile.detail}
                                        </Typography>
                                    </>
                                )}
                            </Grid>
                        </Grid>
                    </DialogContent>
                    <DialogActions>
                        <Button onClick={() => setDetailOpen(false)}>Close</Button>
                    </DialogActions>
                </>
            )}
        </Dialog>
    );

    const ProfileCardSkeleton = () => (
        <Grid item xs={12} sm={6} md={4} lg={3}>
            <Card>
                <Skeleton variant="rectangular" height={200} />
                <CardContent>
                    <Skeleton variant="text" width="60%" height={30} />
                    <Skeleton variant="text" width="40%" />
                    <Skeleton variant="text" width="80%" />
                </CardContent>
            </Card>
        </Grid>
    );

    return (
        <>
            <CssBaseline />
            <Box sx={{ 
                minHeight: '100vh',
                background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                py: { xs: 2, sm: 3, md: 4 },
                px: { xs: 1, sm: 2, md: 0 },
            }}>
                <Container maxWidth="xl">
                    <StyledPaper elevation={3}>
                        {/* Header */}
                        <Box textAlign="center" mb={4}>
                            <Typography variant="h4" fontWeight="bold" sx={{ color: '#c2185b' }}>
                                Find Your Perfect Match
                            </Typography>
                            <Typography variant="subtitle1" color="text.secondary" mt={1}>
                                Browse through profiles and find your soulmate
                            </Typography>
                            <Button
                                variant="outlined"
                                startIcon={<PersonIcon />}
                                onClick={() => navigate('/profile')}
                                sx={{ mt: 2 }}
                            >
                                Create/Edit Your Profile
                            </Button>
                        </Box>

                        <Divider sx={{ mb: 3 }} />

                        {/* Search and Filters */}
                        <Box sx={{ mb: 4 }}>
                            <Grid container spacing={2} alignItems="center">
                                <Grid item xs={12} md={6}>
                                    <TextField
                                        fullWidth
                                        placeholder="Search by name, occupation, education..."
                                        value={searchTerm}
                                        onChange={(e) => setSearchTerm(e.target.value)}
                                        InputProps={{
                                            startAdornment: (
                                                <InputAdornment position="start">
                                                    <SearchIcon />
                                                </InputAdornment>
                                            ),
                                        }}
                                    />
                                </Grid>
                                <Grid item xs={6} md={3}>
                                    <Button
                                        fullWidth
                                        variant="outlined"
                                        startIcon={<FilterListIcon />}
                                        onClick={() => setShowFilters(!showFilters)}
                                    >
                                        Filters
                                    </Button>
                                </Grid>
                                <Grid item xs={6} md={3}>
                                    <Typography variant="body2" color="text.secondary">
                                        {filteredProfiles.length} profile{filteredProfiles.length !== 1 ? 's' : ''} found
                                    </Typography>
                                </Grid>
                            </Grid>

                            {/* Expanded Filters */}
                            {showFilters && (
                                <Box sx={{ mt: 3, p: 2, bgcolor: '#f5f5f5', borderRadius: 2 }}>
                                    <Grid container spacing={2}>
                                        <Grid item xs={12} sm={6} md={3}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Gender</InputLabel>
                                                <Select
                                                    value={filters.gender}
                                                    onChange={handleFilterChange('gender')}
                                                    label="Gender"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Male">Male</MenuItem>
                                                    <MenuItem value="Female">Female</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={3}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Religion</InputLabel>
                                                <Select
                                                    value={filters.religion}
                                                    onChange={handleFilterChange('religion')}
                                                    label="Religion"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Hindu">Hindu</MenuItem>
                                                    <MenuItem value="Muslim">Muslim</MenuItem>
                                                    <MenuItem value="Christian">Christian</MenuItem>
                                                    <MenuItem value="Sikh">Sikh</MenuItem>
                                                    <MenuItem value="Jain">Jain</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={3}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Language</InputLabel>
                                                <Select
                                                    value={filters.language}
                                                    onChange={handleFilterChange('language')}
                                                    label="Language"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Hindi">Hindi</MenuItem>
                                                    <MenuItem value="Marathi">Marathi</MenuItem>
                                                    <MenuItem value="Gujarati">Gujarati</MenuItem>
                                                    <MenuItem value="Tamil">Tamil</MenuItem>
                                                    <MenuItem value="Telugu">Telugu</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={3}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Marital Status</InputLabel>
                                                <Select
                                                    value={filters.maritalStatus}
                                                    onChange={handleFilterChange('maritalStatus')}
                                                    label="Marital Status"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Single">Single</MenuItem>
                                                    <MenuItem value="Divorced">Divorced</MenuItem>
                                                    <MenuItem value="Widowed">Widowed</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={6} sm={3}>
                                            <TextField
                                                fullWidth
                                                size="small"
                                                label="Min Age"
                                                type="number"
                                                value={filters.minAge}
                                                onChange={handleFilterChange('minAge')}
                                                inputProps={{ min: 18, max: 100 }}
                                            />
                                        </Grid>
                                        <Grid item xs={6} sm={3}>
                                            <TextField
                                                fullWidth
                                                size="small"
                                                label="Max Age"
                                                type="number"
                                                value={filters.maxAge}
                                                onChange={handleFilterChange('maxAge')}
                                                inputProps={{ min: 18, max: 100 }}
                                            />
                                        </Grid>
                                        <Grid item xs={12} sm={6}>
                                            <Button 
                                                variant="text" 
                                                onClick={clearFilters}
                                                color="secondary"
                                            >
                                                Clear All Filters
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Box>
                            )}
                        </Box>

                        {/* Profiles Grid */}
                        {loading ? (
                            <Grid container spacing={3}>
                                {[...Array(8)].map((_, index) => (
                                    <ProfileCardSkeleton key={index} />
                                ))}
                            </Grid>
                        ) : filteredProfiles.length === 0 ? (
                            <Box textAlign="center" py={8}>
                                <PersonIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
                                <Typography variant="h5" color="text.secondary" gutterBottom>
                                    No Profiles Found
                                </Typography>
                                <Typography variant="body1" color="text.secondary">
                                    Try adjusting your search filters or check back later
                                </Typography>
                            </Box>
                        ) : (
                            <Grid container spacing={3}>
                                {filteredProfiles.map((profile) => (
                                    <Grid item xs={12} sm={6} md={4} lg={3} key={profile._id}>
                                        <ProfileCard onClick={() => handleProfileClick(profile)}>
                                            <LikeButton
                                                isliked={likedProfiles.has(profile._id) ? 'true' : 'false'}
                                                onClick={(e) => handleLike(profile._id, e)}
                                                size="small"
                                            >
                                                {likedProfiles.has(profile._id) ? 
                                                    <FavoriteIcon /> : 
                                                    <FavoriteBorderIcon />
                                                }
                                            </LikeButton>
                                            <CardMedia
                                                component="div"
                                                sx={{
                                                    height: 200,
                                                    bgcolor: '#e0e0e0',
                                                    display: 'flex',
                                                    alignItems: 'center',
                                                    justifyContent: 'center',
                                                }}
                                            >
                                                <Avatar
                                                    src={profile.image ? `${API_URL}/uploads/${profile.image.split(',')[0]}` : undefined}
                                                    alt={profile.name}
                                                    sx={{ width: '100%', height: '100%' }}
                                                    variant="rounded"
                                                >
                                                    <PersonIcon sx={{ fontSize: 60, color: '#9e9e9e' }} />
                                                </Avatar>
                                            </CardMedia>
                                            <CardContent>
                                                <Typography variant="h6" gutterBottom>
                                                    {profile.name}
                                                </Typography>
                                                <Chip 
                                                    label={`${profile.age} yrs`} 
                                                    size="small" 
                                                    sx={{ mr: 1, mb: 1 }}
                                                />
                                                <Chip 
                                                    label={profile.religion} 
                                                    size="small" 
                                                    variant="outlined"
                                                    sx={{ mr: 1, mb: 1 }}
                                                />
                                                <Box sx={{ display: 'flex', alignItems: 'center', mt: 1, color: 'text.secondary' }}>
                                                    <WorkIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                    <Typography variant="body2" noWrap>
                                                        {profile.occupation || 'Not specified'}
                                                    </Typography>
                                                </Box>
                                                <Box sx={{ display: 'flex', alignItems: 'center', mt: 0.5, color: 'text.secondary' }}>
                                                    <LocationOnIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                    <Typography variant="body2" noWrap>
                                                        {profile.address || 'Location not specified'}
                                                    </Typography>
                                                </Box>
                                            </CardContent>
                                        </ProfileCard>
                                    </Grid>
                                ))}
                            </Grid>
                        )}
                    </StyledPaper>
                </Container>
            </Box>

            {/* Scroll to Top Button */}
            {showScrollTop && (
                <ScrollToTopButton onClick={scrollToTop} size="small">
                    <ArrowUpwardIcon />
                </ScrollToTopButton>
            )}

            {/* Profile Detail Dialog */}
            <ProfileDetailDialog />

            {/* Snackbar for notifications */}
            <Snackbar
                open={snackbar.open}
                autoHideDuration={4000}
                onClose={() => setSnackbar(prev => ({ ...prev, open: false }))}
                anchorOrigin={{ vertical: 'top', horizontal: 'right' }}
            >
                <Alert 
                    onClose={() => setSnackbar(prev => ({ ...prev, open: false }))} 
                    severity={snackbar.severity}
                    variant="filled"
                    sx={{ width: '100%' }}
                >
                    {snackbar.message}
                </Alert>
            </Snackbar>
        </>
    );
}
