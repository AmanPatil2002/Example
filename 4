// components/profile/PhotoUpload.jsx
import React, { useState, useCallback } from 'react';
import {
  Box,
  Typography,
  Grid,
  IconButton,
  Button,
  Card,
  CardMedia,
  CardActions,
  Alert,
  LinearProgress
} from '@mui/material';
import {
  CloudUpload as CloudUploadIcon,
  Delete as DeleteIcon,
  Star as StarIcon,
  StarBorder as StarBorderIcon
} from '@mui/icons-material';
import { useDropzone } from 'react-dropzone';

const PhotoUpload = ({ data, updateData }) => {
  const [error, setError] = useState('');

  const onDrop = useCallback((acceptedFiles, rejectedFiles) => {
    if (rejectedFiles.length > 0) {
      setError('Please upload valid image files (JPG, PNG, max 5MB)');
      return;
    }

    const newPhotos = acceptedFiles.map((file, index) => ({
      id: Date.now() + index,
      file: file,
      preview: URL.createObjectURL(file),
      isPrimary: data.length === 0 && index === 0, // First photo is primary
      isUploaded: false
    }));

    if (data.length + newPhotos.length > 10) {
      setError('You can upload maximum 10 photos');
      return;
    }

    updateData([...data, ...newPhotos]);
    setError('');
  }, [data, updateData]);

  const { getRootProps, getInputProps, isDragActive } = useDropzone({
    onDrop,
    accept: {
      'image/jpeg': ['.jpg', '.jpeg'],
      'image/png': ['.png']
    },
    maxSize: 5242880, // 5MB
    maxFiles: 10
  });

  const handleRemovePhoto = (photoId) => {
    const updatedPhotos = data.filter(photo => photo.id !== photoId);
    // If removed photo was primary, set first photo as primary
    if (updatedPhotos.length > 0 && !updatedPhotos.some(p => p.isPrimary)) {
      updatedPhotos[0].isPrimary = true;
    }
    updateData(updatedPhotos);
    URL.revokeObjectURL(data.find(p => p.id === photoId)?.preview);
  };

  const handleSetPrimary = (photoId) => {
    const updatedPhotos = data.map(photo => ({
      ...photo,
      isPrimary: photo.id === photoId
    }));
    updateData(updatedPhotos);
  };

  return (
    <Box>
      <Typography variant="h6" gutterBottom color="primary" sx={{ mb: 3 }}>
        Upload Photos (Maximum 10)
      </Typography>

      {error && (
        <Alert severity="error" sx={{ mb: 2 }} onClose={() => setError('')}>
          {error}
        </Alert>
      )}

      <Box
        {...getRootProps()}
        sx={{
          border: '2px dashed',
          borderColor: isDragActive ? 'primary.main' : 'grey.300',
          borderRadius: 2,
          p: 4,
          textAlign: 'center',
          backgroundColor: isDragActive ? 'action.hover' : 'background.paper',
          cursor: 'pointer',
          mb: 3,
          '&:hover': {
            borderColor: 'primary.main',
            backgroundColor: 'action.hover'
          }
        }}
      >
        <input {...getInputProps()} />
        <CloudUploadIcon sx={{ fontSize: 48, color: 'primary.main', mb: 1 }} />
        <Typography variant="h6" gutterBottom>
          {isDragActive ? 'Drop photos here' : 'Drag & drop photos or click to browse'}
        </Typography>
        <Typography variant="body2" color="textSecondary">
          Supported formats: JPG, PNG (Max 5MB each)
        </Typography>
      </Box>

      {data.length > 0 && (
        <>
          <Typography variant="subtitle1" gutterBottom>
            {data.length} photo{data.length > 1 ? 's' : ''} selected
          </Typography>
          
          <Grid container spacing={2}>
            {data.map((photo, index) => (
              <Grid item xs={6} sm={4} md={3} key={photo.id}>
                <Card sx={{ position: 'relative' }}>
                  <CardMedia
                    component="img"
                    height="200"
                    image={photo.preview}
                    alt={`Photo ${index + 1}`}
                    sx={{ objectFit: 'cover' }}
                  />
                  
                  {!photo.isUploaded && (
                    <Box sx={{ position: 'absolute', top: 0, left: 0, right: 0 }}>
                      <LinearProgress />
                    </Box>
                  )}
                  
                  <CardActions sx={{ justifyContent: 'space-between' }}>
                    <IconButton
                      size="small"
                      onClick={() => handleSetPrimary(photo.id)}
                      color={photo.isPrimary ? 'primary' : 'default'}
                    >
                      {photo.isPrimary ? <StarIcon /> : <StarBorderIcon />}
                    </IconButton>
                    
                    <IconButton
                      size="small"
                      onClick={() => handleRemovePhoto(photo.id)}
                      color="error"
                    >
                      <DeleteIcon />
                    </IconButton>
                  </CardActions>
                  
                  {photo.isPrimary && (
                    <Typography
                      variant="caption"
                      sx={{
                        position: 'absolute',
                        top: 8,
                        left: 8,
                        backgroundColor: 'primary.main',
                        color: 'white',
                        px: 1,
                        py: 0.5,
                        borderRadius: 1
                      }}
                    >
                      Primary Photo
                    </Typography>
                  )}
                </Card>
              </Grid>
            ))}
          </Grid>
        </>
      )}
    </Box>
  );
};

export default PhotoUpload;
