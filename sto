const db = require("../config/database");

const getStory = (req, res) => {
  const sql = "SELECT * FROM stories";

  db.query(sql, (err, result) => {
    if (err) {
      return res.status(500).json({
        message: "Error",
        error: err.message,
      });
    }
    res.status(200).json(result);
  });
};


const postStory = (req, res) => {
  console.log( req.body);

  const { Couple, City, Date, Image, Story } = req.body;

  const sql =
    "INSERT INTO stories (Couple, City, Date, Image, Story) VALUES (?, ?, ?, ?, ?)";

  db.query(sql, [Couple, City, Date, Image, Story], (err, result) => {
      if (err) {
        console.error(err);
        return res.status(500).json({
          error: err.message,
        });
      }
      res.status(201).json({
        message: "Story added successfully",
        StoryId: result.insertId,Couple,City,Date,Image,Story,
      });
    }
  );
};





module.exports = {
  getStory,
  postStory,
};
