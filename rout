const express = require('express')
const profile = express.Router()

const upload = require('../middleware/upload');
const authenticateToken = require('../middleware/authenticate')
const {getProfile,postProfile,updateProfile,getSingleProfile} = require('../controller/profilecontroller')

profile.get('/profile',getProfile);
profile.post('/profile', upload.single('Image'),authenticateToken,postProfile);
profile.put('/profile/:id', upload.single('Image'),authenticateToken,updateProfile);
profile.delete('/profile/:id',authenticateToken,getSingleProfile);


module.exports = profile;
