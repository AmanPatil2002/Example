// Fix the review form submission
const handleReview = async (e) => {
  e.preventDefault();

  if (!rname.trim() || !remail.trim() || !review.trim()) {
    return;
  }

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(remail)) {
    return;
  }

  setLoading(true);

  try {
    const res = await axios.post(`${API_URL}/api/review`, {
      name: rname,
      email: remail,
      review: review,
    });

    if (res.status === 201) {
      setReview("");
      // Don't call fetchQueries() here unless you want to refresh queries
      // Add success feedback
    }
  } catch (error) {
    console.error("Full error:", error);
    // Add error feedback for user
  } finally {
    setLoading(false);
  }
};

