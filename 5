// pages/Dashboard.jsx
import React, { useState, useEffect } from 'react';
import {
  Container,
  Grid,
  Card,
  CardContent,
  CardActions,
  Typography,
  Button,
  Box,
  Avatar,
  Chip,
  IconButton,
  InputBase,
  Paper,
  Tabs,
  Tab,
  Badge,
  useTheme,
  useMediaQuery
} from '@mui/material';
import {
  Search as SearchIcon,
  Favorite as FavoriteIcon,
  FavoriteBorder as FavoriteBorderIcon,
  Block as BlockIcon,
  Visibility as VisibilityIcon,
  Message as MessageIcon
} from '@mui/icons-material';
import { getDashboardProfiles, sendInterest, shortlistProfile } from '../services/api';

const Dashboard = () => {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('sm'));
  const [profiles, setProfiles] = useState([]);
  const [loading, setLoading] = useState(true);
  const [tab, setTab] = useState(0);
  const [searchTerm, setSearchTerm] = useState('');

  useEffect(() => {
    fetchProfiles();
  }, []);

  const fetchProfiles = async () => {
    try {
      setLoading(true);
      const response = await getDashboardProfiles();
      setProfiles(response.data);
    } catch (error) {
      console.error('Failed to fetch profiles:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleSendInterest = async (userId) => {
    try {
      await sendInterest({ receiverId: userId });
      // Update UI
      setProfiles(profiles.map(profile => 
        profile.id === userId 
          ? { ...profile, interestSent: true }
          : profile
      ));
    } catch (error) {
      console.error('Failed to send interest:', error);
    }
  };

  const handleShortlist = async (userId) => {
    try {
      await shortlistProfile({ userId });
      setProfiles(profiles.map(profile => 
        profile.id === userId 
          ? { ...profile, isShortlisted: !profile.isShortlisted }
          : profile
      ));
    } catch (error) {
      console.error('Failed to shortlist:', error);
    }
  };

  const ProfileCard = ({ profile }) => (
    <Card 
      sx={{ 
        height: '100%', 
        display: 'flex', 
        flexDirection: 'column',
        transition: 'transform 0.2s, box-shadow 0.2s',
        '&:hover': {
          transform: 'translateY(-4px)',
          boxShadow: 6
        }
      }}
    >
      <Box sx={{ position: 'relative' }}>
        <Avatar
          src={profile.primaryPhoto}
          sx={{
            width: '100%',
            height: isMobile ? 200 : 250,
            borderRadius: 0
          }}
          variant="square"
        />
        {profile.isVerified && (
          <Chip
            label="Verified"
            color="success"
            size="small"
            sx={{ position: 'absolute', top: 8, right: 8 }}
          />
        )}
        {profile.membershipType === 'premium' && (
          <Chip
            label="Premium"
            color="primary"
            size="small"
            sx={{ position: 'absolute', top: 8, left: 8 }}
          />
        )}
      </Box>
      
      <CardContent sx={{ flexGrow: 1 }}>
        <Typography variant="h6" gutterBottom>
          {profile.firstName} {profile.lastName}
        </Typography>
        
        <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 0.5, mb: 2 }}>
          <Chip label={`${profile.age} yrs`} size="small" />
          <Chip label={`${profile.heightCm} cm`} size="small" />
          <Chip label={profile.religion} size="small" />
          <Chip label={profile.caste} size="small" />
          <Chip label={profile.occupation} size="small" />
        </Box>
        
        <Typography variant="body2" color="textSecondary" sx={{ mb: 1 }}>
          {profile.education}
        </Typography>
        
        <Typography variant="body2" color="textSecondary">
          {profile.city}, {profile.state}
        </Typography>
      </CardContent>
      
      <CardActions sx={{ justifyContent: 'space-between', px: 2, pb: 2 }}>
        <Box>
          <IconButton 
            color={profile.interestSent ? 'primary' : 'default'}
            onClick={() => handleSendInterest(profile.id)}
            disabled={profile.interestSent}
          >
            {profile.interestSent ? <FavoriteIcon /> : <FavoriteBorderIcon />}
          </IconButton>
          <IconButton 
            color={profile.isShortlisted ? 'warning' : 'default'}
            onClick={() => handleShortlist(profile.id)}
          >
            <StarIcon />
          </IconButton>
        </Box>
        
        <Button 
          variant="contained" 
          size="small"
          href={`/profile/${profile.id}`}
        >
          View Profile
        </Button>
      </CardActions>
    </Card>
  );

  return (
    <Container maxWidth="xl" sx={{ mt: 4, mb: 4 }}>
      {/* Search Bar */}
      <Paper
        component="form"
        sx={{ p: '2px 4px', display: 'flex', alignItems: 'center', mb: 3 }}
      >
        <IconButton sx={{ p: '10px' }}>
          <SearchIcon />
        </IconButton>
        <InputBase
          sx={{ ml: 1, flex: 1 }}
          placeholder="Search by name, religion, caste, profession..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
        />
        <Button variant="contained" sx={{ m: 1 }}>
          Search
        </Button>
      </Paper>

      {/* Quick Stats */}
      <Grid container spacing={2} sx={{ mb: 3 }}>
        {[
          { label: 'Profile Views', value: '245', icon: <VisibilityIcon />, color: '#1976d2' },
          { label: 'Interests Received', value: '18', icon: <FavoriteIcon />, color: '#dc004e' },
          { label: 'Shortlisted', value: '12', icon: <StarIcon />, color: '#ed6c02' },
          { label: 'Messages', value: '5', icon: <MessageIcon />, color: '#2e7d32' }
        ].map((stat, index) => (
          <Grid item xs={6} sm={3} key={index}>
            <Paper sx={{ p: 2, textAlign: 'center' }}>
              <Box sx={{ color: stat.color, mb: 1 }}>
                {stat.icon}
              </Box>
              <Typography variant="h5" fontWeight="bold">
                {stat.value}
              </Typography>
              <Typography variant="body2" color="textSecondary">
                {stat.label}
              </Typography>
            </Paper>
          </Grid>
        ))}
      </Grid>

      {/* Profile Grid */}
      <Tabs 
        value={tab} 
        onChange={(e, newValue) =>
