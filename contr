const db = require("../config/database");

const getProfile = (req, res) => {
    db.query("SELECT * FROM profile", (err, result) => {
        if (err) return res.status(500).json(err);
        res.json(result);
    });
};

const postProfile = (req, res) => {
   const { gender, name, email, age, dob, contact, address, language, religion, education, occupation, company, income, image, status, detail, physical, height } = req.body;
    const sql = `
    INSERT INTO profile
    (Gender, Name, Email, Age, DOB, Contact, Address, Language, Religion,
     Education, Occupation, CompanyName, MonthlyIncome, Image, Status,
     Detail, Physically, Height)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `;

    db.query(
        sql,[gender, name, email, age, dob, contact, address, language, religion, education, occupation, company, income, image, status, detail, physical, height,],
        (err, result) => {
            if (err) return res.status(500).json(err);

            res.json({
                message: "Added Successfully",
                id: result.insertId,
            });
        }
    );
};


const updateProfile = (req, res) => {
    const { id } = req.params;
    const { gender, name, email, age, dob, contact, address, language, religion, education, occupation, company, income, image, status, detail, physical, height } = req.body;
    const sql = `UPDATE question SET Gender=?,Name=?,Email=?,Age=?,DOB=?,Contact=?,Address=?,Language=?,Religion=?,Education=?,Occupation=?,CompanyName=?,MonthlyIncome=?,Image=?,Status=?,Detail=?,Physically=?,Height=? WHERE RegisterID =?`;
    db.query(sql, [gender, name, email, age, dob, contact, address, language, religion, education, occupation, company, income, image, status, detail, physical, height, id], (err, result) => {
        if (err) {
            return res.status(500).json(err);
        }
        return res.json({ message: "Updated Successfully", });
    }
    );
};

const deleteProfile = (req, res) => {
    const { id } = req.params;
    const sql = "DELETE FROM profile WHERE RegisterID = ?";
    db.query(sql, [id], (err, result) => {
        if (err) {
            return res.status(500).json(err);
        }
        res.json({ message: "Deleted Successfully", });
    });
};

module.exports = { getProfile, postProfile, updateProfile, deleteProfile };

