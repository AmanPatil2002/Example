const db = require("../config/database");
const path = require('path');
const fs = require('fs');

const getStory = (req, res) => {
  const sql = "SELECT * FROM stories";

  db.query(sql, (err, result) => {
    if (err) {
      return res.status(500).json({
        message: "Error",
        error: err.message,
      });
    }

    // Ensure image URLs are complete
    const stories = result.map(story => ({
      ...story,
      Image: story.Image ? `http://localhost:${process.env.PORT || 5000}/${story.Image}` : null
    }));
    res.status(200).json(stories);
  });
};


const postStory = (req, res) => {
  console.log("Request body:", req.body);
  console.log("Request file:", req.file);

  const { Couple, City, Date, Story } = req.body;
  
  // Get the uploaded file path
  const Image = req.file ? req.file.path.replace(/\\/g, '/') : null;

  // Validate required fields
  if (!Couple || !City || !Date || !Story) {
    // Delete uploaded file if validation fails
    if (req.file) {
      fs.unlink(req.file.path, (err) => {
        if (err) console.error("Error deleting file:", err);
      });
    }
    return res.status(400).json({
      error: "All fields are required: Couple, City, Date, Story"
    });
  }

  const sql =
    "INSERT INTO stories (Couple, City, Date, Image, Story) VALUES (?, ?, ?, ?, ?)";

  db.query(sql, [Couple, City, Date, Image, Story], (err, result) => {
    if (err) {
      console.error("Database error:", err);
      // Delete uploaded file if database insert fails
      if (req.file) {
        fs.unlink(req.file.path, (unlinkErr) => {
          if (unlinkErr) console.error("Error deleting file:", unlinkErr);
        });
      }
      return res.status(500).json({
        error: err.message,
      });
    }
    
    const imageUrl = Image ? `http://localhost:${process.env.PORT || 5000}/${Image}` : null;
    
    res.status(201).json({
      message: "Story added successfully",
      StoryId: result.insertId,
      Couple,
      City,
      Date,
      Image: imageUrl,
      Story,
    });
  });
};


module.exports = {
  getStory,
  postStory,
};
