import {
    Box,
    Container,
    CssBaseline,
    Grid,
    Paper,
    Typography,
    Divider,
    Card,
    CardContent,
    CardMedia,
    Alert,
    Snackbar,
    Avatar,
    Chip,
    Button,
    IconButton,
    Dialog,
    DialogTitle,
    DialogContent,
    DialogActions,
    TextField,
    Skeleton,
    InputAdornment,
    MenuItem,
    Select,
    FormControl,
    InputLabel,
} from "@mui/material";
import { styled } from "@mui/material/styles";
import SearchIcon from '@mui/icons-material/Search';
import FilterListIcon from '@mui/icons-material/FilterList';
import PersonIcon from '@mui/icons-material/Person';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import SchoolIcon from '@mui/icons-material/School';
import WorkIcon from '@mui/icons-material/Work';
import FavoriteIcon from '@mui/icons-material/Favorite';
import FavoriteBorderIcon from '@mui/icons-material/FavoriteBorder';
import CloseIcon from '@mui/icons-material/Close';
import InfoIcon from '@mui/icons-material/Info';
import { useState, useEffect, useCallback } from "react";
import { useNavigate } from "react-router-dom";
import axios from "axios";

const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000';

const StyledPaper = styled(Paper)(({ theme }) => ({
    padding: theme.spacing(3),
    borderRadius: 16,
    boxShadow: '0 8px 32px rgba(0,0,0,0.1)',
    [theme.breakpoints.down('sm')]: {
        padding: theme.spacing(2),
        borderRadius: 12,
    },
}));

const ProfileCard = styled(Card)(({ theme }) => ({
    height: '100%',
    transition: 'transform 0.3s, box-shadow 0.3s',
    cursor: 'pointer',
    position: 'relative',
    overflow: 'visible',
    '&:hover': {
        transform: 'translateY(-8px)',
        boxShadow: '0 12px 40px rgba(0,0,0,0.15)',
    },
}));

const LikeButton = styled(IconButton)(({ theme, isliked }) => ({
    position: 'absolute',
    top: 10,
    right: 10,
    backgroundColor: 'white',
    boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
    '&:hover': {
        backgroundColor: '#fce4ec',
    },
    color: isliked === 'true' ? '#e91e63' : 'grey',
    zIndex: 1,
}));

export default function Match() {
    const navigate = useNavigate();
    const [profiles, setProfiles] = useState([]);
    const [filteredProfiles, setFilteredProfiles] = useState([]);
    const [loading, setLoading] = useState(true);
    const [selectedProfile, setSelectedProfile] = useState(null);
    const [detailOpen, setDetailOpen] = useState(false);
    const [likedProfiles, setLikedProfiles] = useState(new Set());
    const [snackbar, setSnackbar] = useState({ open: false, message: '', severity: 'success' });

    const [searchTerm, setSearchTerm] = useState('');
    const [filters, setFilters] = useState({
        gender: '',
        religion: '',
        language: '',
        minAge: '',
        maxAge: '',
        maritalStatus: '',
    });
    const [showFilters, setShowFilters] = useState(false);

    // Get current user email to filter out their own profile
    const currentUserEmail = localStorage.getItem('email');

    useEffect(() => {
        fetchProfiles();
    }, []);

    const fetchProfiles = async () => {
        setLoading(true);
        try {
            // FIX: Use the correct endpoint that matches your backend route
            const res = await axios.get(`${API_URL}/profile/profile`);
            console.log("Fetched profiles:", res.data);
            
            let allProfiles = res.data;
            
            // Ensure we have an array
            if (!Array.isArray(allProfiles)) {
                allProfiles = [allProfiles];
            }
            
            // FIX: Filter out current user's profile using email (matching your backend field names)
            const otherProfiles = currentUserEmail 
                ? allProfiles.filter(profile => profile.Email !== currentUserEmail)
                : allProfiles;
            
            setProfiles(otherProfiles);
            setFilteredProfiles(otherProfiles);
        } catch (err) {
            console.log('Error fetching profiles:', err);
            setSnackbar({
                open: true,
                message: 'Failed to fetch profiles. Please try again later.',
                severity: 'error'
            });
        } finally {
            setLoading(false);
        }
    };

    const applyFilters = useCallback(() => {
        let filtered = [...profiles];
        
        if (searchTerm) {
            const term = searchTerm.toLowerCase();
            filtered = filtered.filter(profile => 
                profile.Name?.toLowerCase().includes(term) ||
                profile.Occupation?.toLowerCase().includes(term) ||
                profile.Education?.toLowerCase().includes(term) ||
                profile.Address?.toLowerCase().includes(term)
            );
        }

        if (filters.gender) {
            filtered = filtered.filter(profile => profile.Gender === filters.gender);
        }
        if (filters.religion) {
            filtered = filtered.filter(profile => profile.Religion === filters.religion);
        }
        if (filters.language) {
            filtered = filtered.filter(profile => profile.Language === filters.language);
        }
        if (filters.minAge) {
            filtered = filtered.filter(profile => profile.Age >= parseInt(filters.minAge));
        }
        if (filters.maxAge) {
            filtered = filtered.filter(profile => profile.Age <= parseInt(filters.maxAge));
        }
        if (filters.maritalStatus) {
            filtered = filtered.filter(profile => profile.Status === filters.maritalStatus);
        }

        setFilteredProfiles(filtered);
    }, [profiles, searchTerm, filters]);

    useEffect(() => {
        applyFilters();
    }, [applyFilters]);

    const handleLike = (profileId, event) => {
        event.stopPropagation();
        setLikedProfiles(prev => {
            const newLikes = new Set(prev);
            if (newLikes.has(profileId)) {
                newLikes.delete(profileId);
            } else {
                newLikes.add(profileId);
            }
            return newLikes;
        });
        
        setSnackbar({
            open: true,
            message: likedProfiles.has(profileId) ? 'Removed from favorites' : 'Added to favorites! ❤️',
            severity: 'success'
        });
    };

    const handleProfileClick = (profile) => {
        setSelectedProfile(profile);
        setDetailOpen(true);
    };

    const handleFilterChange = (field) => (event) => {
        setFilters(prev => ({
            ...prev,
            [field]: event.target.value
        }));
    };

    const clearFilters = () => {
        setSearchTerm('');
        setFilters({
            gender: '',
            religion: '',
            language: '',
            minAge: '',
            maxAge: '',
            maritalStatus: '',
        });
    };

    // FIX: Helper function to get correct image URL
    const getImageUrl = (imagePath) => {
        if (!imagePath) return null;
        if (imagePath.startsWith('http')) return imagePath;
        // Remove any leading slash and ensure proper path
        const cleanPath = imagePath.replace(/^\/+/, '');
        return `${API_URL}/${cleanPath}`;
    };

    const ProfileDetailDialog = () => (
        <Dialog 
            open={detailOpen} 
            onClose={() => setDetailOpen(false)}
            maxWidth="md"
            fullWidth
        >
            {selectedProfile && (
                <>
                    <DialogTitle sx={{ 
                        display: 'flex', 
                        justifyContent: 'space-between', 
                        alignItems: 'center',
                        background: 'linear-gradient(135deg, #c2185b 0%, #e91e63 100%)',
                        color: 'white'
                    }}>
                        <Typography variant="h5" fontWeight="bold">
                            {selectedProfile.Name}'s Profile
                        </Typography>
                        <IconButton onClick={() => setDetailOpen(false)} sx={{ color: 'white' }}>
                            <CloseIcon />
                        </IconButton>
                    </DialogTitle>
                    <DialogContent dividers sx={{ p: 3 }}>
                        <Grid container spacing={3}>
                            <Grid item xs={12} md={4}>
                                <Box textAlign="center">
                                    <Avatar
                                        src={getImageUrl(selectedProfile.Image)}
                                        alt={selectedProfile.Name}
                                        sx={{ 
                                            width: 200, 
                                            height: 200, 
                                            mx: 'auto',
                                            mb: 2,
                                            borderRadius: 2,
                                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                        }}
                                        variant="rounded"
                                    >
                                        <PersonIcon sx={{ fontSize: 100 }} />
                                    </Avatar>
                                    <Typography variant="h6" gutterBottom>
                                        {selectedProfile.Name}
                                    </Typography>
                                    <Box sx={{ display: 'flex', gap: 1, justifyContent: 'center', flexWrap: 'wrap' }}>
                                        <Chip label={`${selectedProfile.Age} years`} size="small" color="secondary" />
                                        <Chip label={`${selectedProfile.Height} ft`} size="small" color="primary" />
                                    </Box>
                                </Box>
                            </Grid>
                            <Grid item xs={12} md={8}>
                                <Typography variant="h6" gutterBottom sx={{ 
                                    display: 'flex', 
                                    alignItems: 'center', 
                                    gap: 1,
                                    color: '#c2185b'
                                }}>
                                    <InfoIcon /> Personal Information
                                </Typography>
                                <Grid container spacing={2}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Gender</Typography>
                                        <Typography variant="body1" fontWeight="medium">{selectedProfile.Gender || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Religion</Typography>
                                        <Typography variant="body1" fontWeight="medium">{selectedProfile.Religion || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Mother Tongue</Typography>
                                        <Typography variant="body1" fontWeight="medium">{selectedProfile.Language || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Marital Status</Typography>
                                        <Chip label={selectedProfile.Status || 'Not specified'} size="small" />
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Location</Typography>
                                        <Typography variant="body1">
                                            <LocationOnIcon fontSize="small" sx={{ verticalAlign: 'middle', mr: 0.5 }} />
                                            {selectedProfile.Address || 'Not specified'}
                                        </Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Date of Birth</Typography>
                                        <Typography variant="body1">
                                            {selectedProfile.DOB ? new Date(selectedProfile.DOB).toLocaleDateString() : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                <Divider sx={{ my: 2 }} />

                                <Typography variant="h6" gutterBottom sx={{ 
                                    display: 'flex', 
                                    alignItems: 'center', 
                                    gap: 1,
                                    color: '#c2185b'
                                }}>
                                    <SchoolIcon /> Education & Career
                                </Typography>
                                <Grid container spacing={2}>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Education</Typography>
                                        <Typography variant="body1" fontWeight="medium">{selectedProfile.Education || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Occupation</Typography>
                                        <Typography variant="body1" fontWeight="medium">{selectedProfile.Occupation || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Company</Typography>
                                        <Typography variant="body1" fontWeight="medium">{selectedProfile.CompanyName || 'Not specified'}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="body2" color="text.secondary">Monthly Income</Typography>
                                        <Typography variant="body1" fontWeight="medium">
                                            {selectedProfile.MonthlyIncome ? `₹${parseInt(selectedProfile.MonthlyIncome).toLocaleString()}` : 'Not specified'}
                                        </Typography>
                                    </Grid>
                                </Grid>

                                {selectedProfile.Detail && (
                                    <>
                                        <Divider sx={{ my: 2 }} />
                                        <Typography variant="h6" gutterBottom sx={{ 
                                            display: 'flex', 
                                            alignItems: 'center', 
                                            gap: 1,
                                            color: '#c2185b'
                                        }}>
                                            <FavoriteIcon /> About Me
                                        </Typography>
                                        <Paper sx={{ p: 2, bgcolor: '#fdf2f8', borderRadius: 2 }}>
                                            <Typography variant="body1" sx={{ whiteSpace: 'pre-line', lineHeight: 1.8 }}>
                                                {selectedProfile.Detail}
                                            </Typography>
                                        </Paper>
                                    </>
                                )}

                                {selectedProfile.Physically && (
                                    <>
                                        <Divider sx={{ my: 2 }} />
                                        <Typography variant="body2" color="text.secondary">Physical Status</Typography>
                                        <Chip 
                                            label={selectedProfile.Physically === 'Yes' ? 'Physically Challenged' : 'Not Physically Challenged'} 
                                            size="small"
                                            color={selectedProfile.Physically === 'Yes' ? 'warning' : 'success'}
                                            sx={{ mt: 1 }}
                                        />
                                    </>
                                )}
                            </Grid>
                        </Grid>
                    </DialogContent>
                    <DialogActions>
                        <Button onClick={() => setDetailOpen(false)} variant="outlined">Close</Button>
                        <Button 
                            variant="contained"
                            sx={{
                                background: 'linear-gradient(45deg, #c2185b 30%, #e91e63 90%)',
                            }}
                            onClick={() => {
                                // Navigate to contact or send interest
                                navigate('/contact');
                            }}
                        >
                            Send Interest
                        </Button>
                    </DialogActions>
                </>
            )}
        </Dialog>
    );

    const ProfileCardSkeleton = () => (
        <Grid item xs={12} sm={6} md={4} lg={3}>
            <Card>
                <Skeleton variant="rectangular" height={200} />
                <CardContent>
                    <Skeleton variant="text" width="60%" height={30} />
                    <Skeleton variant="text" width="40%" />
                    <Skeleton variant="text" width="80%" />
                </CardContent>
            </Card>
        </Grid>
    );

    return (
        <>
            <CssBaseline />
            <Box sx={{ 
                minHeight: '100vh',
                background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
                py: { xs: 2, sm: 3, md: 4 },
                px: { xs: 1, sm: 2, md: 0 },
            }}>
                <Container maxWidth="xl">
                    <StyledPaper elevation={3}>
                        <Box textAlign="center" mb={4}>
                            <Typography variant="h4" fontWeight="bold" sx={{ color: '#c2185b' }}>
                                Find Your Perfect Match
                            </Typography>
                            <Typography variant="subtitle1" color="text.secondary" mt={1}>
                                Browse through profiles and find your soulmate
                            </Typography>
                            <Box sx={{ display: 'flex', gap: 2, justifyContent: 'center', mt: 2 }}>
                                <Button
                                    variant="outlined"
                                    startIcon={<PersonIcon />}
                                    onClick={() => navigate('/profile')}
                                >
                                    Create Your Profile
                                </Button>
                                <Button
                                    variant="outlined"
                                    startIcon={<FavoriteIcon />}
                                    onClick={() => navigate('/success-stories')}
                                    color="secondary"
                                >
                                    Success Stories
                                </Button>
                            </Box>
                        </Box>

                        <Divider sx={{ mb: 3 }} />

                        {/* Search and Filters */}
                        <Box sx={{ mb: 4 }}>
                            <Grid container spacing={2} alignItems="center">
                                <Grid item xs={12} md={6}>
                                    <TextField
                                        fullWidth
                                        placeholder="Search by name, occupation, education, location..."
                                        value={searchTerm}
                                        onChange={(e) => setSearchTerm(e.target.value)}
                                        InputProps={{
                                            startAdornment: (
                                                <InputAdornment position="start">
                                                    <SearchIcon />
                                                </InputAdornment>
                                            ),
                                        }}
                                    />
                                </Grid>
                                <Grid item xs={6} md={3}>
                                    <Button
                                        fullWidth
                                        variant={showFilters ? "contained" : "outlined"}
                                        startIcon={<FilterListIcon />}
                                        onClick={() => setShowFilters(!showFilters)}
                                        sx={showFilters ? {
                                            background: 'linear-gradient(45deg, #c2185b 30%, #e91e63 90%)',
                                        } : {}}
                                    >
                                        Filters
                                    </Button>
                                </Grid>
                                <Grid item xs={6} md={3}>
                                    <Typography variant="body2" color="text.secondary" textAlign="center">
                                        {filteredProfiles.length} profile{filteredProfiles.length !== 1 ? 's' : ''} found
                                    </Typography>
                                </Grid>
                            </Grid>

                            {/* Expanded Filters */}
                            {showFilters && (
                                <Box sx={{ mt: 3, p: 3, bgcolor: '#f5f5f5', borderRadius: 2 }}>
                                    <Grid container spacing={2}>
                                        <Grid item xs={12} sm={6} md={4}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Gender</InputLabel>
                                                <Select
                                                    value={filters.gender}
                                                    onChange={handleFilterChange('gender')}
                                                    label="Gender"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Male">Male</MenuItem>
                                                    <MenuItem value="Female">Female</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={4}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Religion</InputLabel>
                                                <Select
                                                    value={filters.religion}
                                                    onChange={handleFilterChange('religion')}
                                                    label="Religion"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Hindu">Hindu</MenuItem>
                                                    <MenuItem value="Muslim">Muslim</MenuItem>
                                                    <MenuItem value="Christian">Christian</MenuItem>
                                                    <MenuItem value="Sikh">Sikh</MenuItem>
                                                    <MenuItem value="Jain">Jain</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={4}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Language</InputLabel>
                                                <Select
                                                    value={filters.language}
                                                    onChange={handleFilterChange('language')}
                                                    label="Language"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Hindi">Hindi</MenuItem>
                                                    <MenuItem value="Marathi">Marathi</MenuItem>
                                                    <MenuItem value="Gujarati">Gujarati</MenuItem>
                                                    <MenuItem value="Tamil">Tamil</MenuItem>
                                                    <MenuItem value="Telugu">Telugu</MenuItem>
                                                    <MenuItem value="English">English</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={4}>
                                            <FormControl fullWidth size="small">
                                                <InputLabel>Marital Status</InputLabel>
                                                <Select
                                                    value={filters.maritalStatus}
                                                    onChange={handleFilterChange('maritalStatus')}
                                                    label="Marital Status"
                                                >
                                                    <MenuItem value="">All</MenuItem>
                                                    <MenuItem value="Single">Single</MenuItem>
                                                    <MenuItem value="Divorced">Divorced</MenuItem>
                                                    <MenuItem value="Widowed">Widowed</MenuItem>
                                                </Select>
                                            </FormControl>
                                        </Grid>
                                        <Grid item xs={6} sm={3} md={2}>
                                            <TextField
                                                fullWidth
                                                size="small"
                                                label="Min Age"
                                                type="number"
                                                value={filters.minAge}
                                                onChange={handleFilterChange('minAge')}
                                                inputProps={{ min: 18, max: 100 }}
                                            />
                                        </Grid>
                                        <Grid item xs={6} sm={3} md={2}>
                                            <TextField
                                                fullWidth
                                                size="small"
                                                label="Max Age"
                                                type="number"
                                                value={filters.maxAge}
                                                onChange={handleFilterChange('maxAge')}
                                                inputProps={{ min: 18, max: 100 }}
                                            />
                                        </Grid>
                                        <Grid item xs={12} sm={6} md={4}>
                                            <Button 
                                                fullWidth
                                                variant="text" 
                                                onClick={clearFilters}
                                                color="secondary"
                                                sx={{ mt: 1 }}
                                            >
                                                Clear All Filters
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Box>
                            )}
                        </Box>

                        {/* Profiles Grid */}
                        {loading ? (
                            <Grid container spacing={3}>
                                {[...Array(8)].map((_, index) => (
                                    <ProfileCardSkeleton key={index} />
                                ))}
                            </Grid>
                        ) : filteredProfiles.length === 0 ? (
                            <Box textAlign="center" py={8}>
                                <PersonIcon sx={{ fontSize: 80, color: 'text.secondary', mb: 2 }} />
                                <Typography variant="h5" color="text.secondary" gutterBottom>
                                    No Profiles Found
                                </Typography>
                                <Typography variant="body1" color="text.secondary" gutterBottom>
                                    Try adjusting your search filters or check back later
                                </Typography>
                                <Button
                                    variant="outlined"
                                    onClick={clearFilters}
                                    sx={{ mt: 2 }}
                                >
                                    Clear Filters
                                </Button>
                            </Box>
                        ) : (
                            <Grid container spacing={3}>
                                {filteredProfiles.map((profile) => (
                                    <Grid item xs={12} sm={6} md={4} lg={3} key={profile.RegisterID}>
                                        <ProfileCard onClick={() => handleProfileClick(profile)}>
                                            <LikeButton
                                                isliked={likedProfiles.has(profile.RegisterID) ? 'true' : 'false'}
                                                onClick={(e) => handleLike(profile.RegisterID, e)}
                                                size="small"
                                            >
                                                {likedProfiles.has(profile.RegisterID) ? 
                                                    <FavoriteIcon /> : 
                                                    <FavoriteBorderIcon />
                                                }
                                            </LikeButton>
                                            <CardMedia
                                                component="div"
                                                sx={{
                                                    height: 200,
                                                    background: profile.Gender === 'Female' 
                                                        ? 'linear-gradient(135deg, #fce4ec 0%, #f8bbd0 100%)'
                                                        : 'linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%)',
                                                    display: 'flex',
                                                    alignItems: 'center',
                                                    justifyContent: 'center',
                                                }}
                                            >
                                                <Avatar
                                                    src={getImageUrl(profile.Image)}
                                                    alt={profile.Name}
                                                    sx={{ 
                                                        width: 120, 
                                                        height: 120,
                                                        border: '4px solid white',
                                                        boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
                                                    }}
                                                >
                                                    <PersonIcon sx={{ fontSize: 60, color: '#9e9e9e' }} />
                                                </Avatar>
                                            </CardMedia>
                                            <CardContent>
                                                <Typography variant="h6" gutterBottom sx={{ color: '#c2185b' }}>
                                                    {profile.Name}
                                                </Typography>
                                                <Box sx={{ mb: 1 }}>
                                                    <Chip 
                                                        label={`${profile.Age} yrs`} 
                                                        size="small" 
                                                        color="secondary"
                                                        sx={{ mr: 1, mb: 1 }}
                                                    />
                                                    <Chip 
                                                        label={profile.Religion} 
                                                        size="small" 
                                                        variant="outlined"
                                                        color="primary"
                                                        sx={{ mr: 1, mb: 1 }}
                                                    />
                                                    <Chip 
                                                        label={profile.Status} 
                                                        size="small" 
                                                        variant="outlined"
                                                        sx={{ mb: 1 }}
                                                    />
                                                </Box>
                                                <Box sx={{ display: 'flex', alignItems: 'center', mt: 1, color: 'text.secondary' }}>
                                                    <WorkIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                    <Typography variant="body2" noWrap>
                                                        {profile.Occupation || 'Not specified'}
                                                    </Typography>
                                                </Box>
                                                <Box sx={{ display: 'flex', alignItems: 'center', mt: 0.5, color: 'text.secondary' }}>
                                                    <SchoolIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                    <Typography variant="body2" noWrap>
                                                        {profile.Education || 'Not specified'}
                                                    </Typography>
                                                </Box>
                                                <Box sx={{ display: 'flex', alignItems: 'center', mt: 0.5, color: 'text.secondary' }}>
                                                    <LocationOnIcon fontSize="small" sx={{ mr: 0.5 }} />
                                                    <Typography variant="body2" noWrap>
                                                        {profile.Address || 'Location not specified'}
                                                    </Typography>
                                                </Box>
                                            </CardContent>
                                        </ProfileCard>
                                    </Grid>
                                ))}
                            </Grid>
                        )}
                    </StyledPaper>
                </Container>
            </Box>

            {/* Profile Detail Dialog */}
            <ProfileDetailDialog />

            {/* Snackbar for notifications */}
            <Snackbar
                open={snackbar.open}
                autoHideDuration={6000}
                onClose={() => setSnackbar({ ...snackbar, open: false })}
            >
                <Alert 
                    onClose={() => setSnackbar({ ...snackbar, open: false })} 
                    severity={snackbar.severity}
                    sx={{ width: '100%' }}
                >
                    {snackbar.message}
                </Alert>
            </Snackbar>
        </>
    );
}
